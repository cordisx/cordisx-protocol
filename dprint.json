{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "includes": [
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,md}"
  ],
  // Formatting excludes build outputs and the npm-generated lock; source generators and tests remain included.
  "excludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "package-lock.json",
    // Preserve frozen public declarations, serialized schemas, and conformance vectors byte-for-byte.
    "types/**/*.d.ts",
    "runtime/**",
    // Topic specifications are public contracts; only the top-level documentation index is formatted.
    ".agents/docs/*/**",
    ".agents/docs/plugin-devtools-console.md",
    ".agents/docs/publisher-grants.md",
    "schemas/**/*.json",
    "test-vectors/*/**"
  ],
  "extends": "https://raw.githubusercontent.com/cordisx/cordisxmono/c63c2e8c2ba7e11502934a52ad2ce3734e804cdc/tooling/quality/dprint/code.json"
}
