      "contract": "cordisx.agent-definition/v1",
      "schemaVersion": 1,
      "identity": { "agentId": "parent-generated", "revision": "definition-1" },
      "avatar": { "kind": "generated", "algorithm": "oneworks-avatar-seed", "algorithmVersion": 1, "seed": "cordisx.agent-avatar.seed/v1:agent-definition:16:parent-generated" },
