      "identity": { "agentId": "parent-asset", "revision": "definition-1" },
      "avatar": { "kind": "asset", "ref": "avatar-assets:parent" },
      "inherit": { "promptSections": "none", "rules": "none", "skills": "none", "tools": "none", "mcpServers": "none", "runtimeDefaults": "none" }
