  "assertions": [
    { "agentId": "child-explicit", "revision": "definition-2", "expected": { "kind": "definition", "ref": "avatar-definitions:child", "schema": "oneworks.avatar", "definitionVersion": 1 } },
    { "agentId": "child-inherit", "revision": "definition-2", "expected": { "kind": "asset", "ref": "avatar-assets:parent" } },
