{
  "$schema": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-authorization-plan.v5.schema.json",
  "schemaVersion": 5,
  "planId": "certified-enable-1",
  "operation": "enable",
  "profileId": "work",
  "identity": { "source": "https://marketplace.example/plugins/tool", "pluginId": "tool" },
