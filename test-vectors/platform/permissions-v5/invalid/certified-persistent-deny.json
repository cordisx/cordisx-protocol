    "presentation": {
      "name": { "key": "permission.models.read.name", "fallback": "Read model information" },
      "description": { "key": "permission.models.read.description", "fallback": "Reads selected model information." },
      "risk": { "key": "permission.models.read.risk", "fallback": "May expose model metadata." },
      "limitation": { "key": "permission.models.read.limitation", "fallback": "Only declared providers are visible." }
    }
  }]
