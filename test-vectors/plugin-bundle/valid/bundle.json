{
  "case": "bundle",
  "value": {
    "$schema": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle.v1.schema.json",
    "schemaVersion": 1,
    "id": "team-workflow",
    "name": "Team workflow",
    "description": "A coordinated set of workflow plugins.",
    "version": "1.0.0",
    "authors": ["CordisX"],
    "readme": "./README.md",
    "icon": "./assets/icon.svg",
    "canonicalSource": "https://plugins.example/team-workflow",
    "distribution": { "mode": "explicit-local-v1", "signature": "unsupported" },
    "members": [
      { "id": "storage", "version": "1.0.0", "path": "./plugins/storage", "required": true, "enabledByDefault": true },
      { "id": "notes", "version": "1.2.0", "path": "./plugins/notes", "required": false, "enabledByDefault": true }
    ]
  }
}
