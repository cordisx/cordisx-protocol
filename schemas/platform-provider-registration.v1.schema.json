{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/platform-provider-registration.v1.schema.json",
  "title": "CordisX Platform Provider Registration Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "registrationId", "owner", "descriptor", "mapping", "providerGeneration", "brokerPolicy", "configuration", "state"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/platform-provider-registration.v1.schema.json" },
    "contract": { "const": "cordisx.platform-provider-registration/v1" },
    "schemaVersion": { "const": 1 },
    "registrationId": { "type": "string", "pattern": "^ppr_[A-Za-z0-9._:-]{1,128}$" },
    "owner": { "$ref": "platform-provider-common.v1.schema.json#/$defs/owner" },
    "descriptor": { "$ref": "platform-provider-descriptor.v1.schema.json" },
    "mapping": { "$ref": "#/$defs/mapping" },
    "providerGeneration": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brokerPolicy": { "$ref": "platform-provider-broker-policy.v1.schema.json" },
    "configuration": { "$ref": "platform-provider-factory-configuration.v1.schema.json" },
    "state": { "enum": ["staged", "ready", "active", "draining", "failed", "disposed"] }
  },
  "$defs": {
    "modelMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceModelId", "modelId", "enabled", "isDefault"],
      "properties": {
        "sourceModelId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "enabled": { "type": "boolean" },
        "isDefault": { "type": "boolean" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "models": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/modelMapping" }
        }
      }
    }
  }
}
