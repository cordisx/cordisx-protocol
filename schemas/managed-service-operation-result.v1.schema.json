{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-operation-result.v1.schema.json",
  "title": "CordisX Managed Backend Service Operation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "requestId",
    "operation",
    "status"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-operation-result.v1.schema.json"
    },
    "contract": {
      "const": "cordisx.managed-service-operation-result/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "enum": [
        "authenticate",
        "ensure-ready",
        "inspect",
        "restart",
        "dispose",
        "acquire",
        "invoke",
        "materialize"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "accepted",
        "authentication-required",
        "unavailable",
        "failed",
        "cancelled",
        "stale-generation",
        "stale-catalog"
      ]
    },
    "projection": {
      "$ref": "managed-service-projection.v1.schema.json"
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseHandle",
        "binding",
        "brokerHandle",
        "operations"
      ],
      "properties": {
        "leaseHandle": {
          "type": "string",
          "pattern": "^msl_[A-Za-z0-9._:-]{1,128}$"
        },
        "binding": {
          "$ref": "managed-service-common.v1.schema.json#/$defs/binding"
        },
        "brokerHandle": {
          "type": "string",
          "pattern": "^msb_[A-Za-z0-9._:-]{1,128}$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "managed-service-common.v1.schema.json#/$defs/localId"
          }
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationHandle",
        "operationId",
        "responseSchema",
        "value"
      ],
      "properties": {
        "operationId": {
          "$ref": "managed-service-common.v1.schema.json#/$defs/localId"
        },
        "responseSchema": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 512
        },
        "value": {
          "$ref": "managed-service-common.v1.schema.json#/$defs/safeValue"
        },
        "invocationHandle": {
          "type": "string",
          "pattern": "^msi_[A-Za-z0-9._:-]{1,128}$"
        }
      }
    },
    "diagnostic": {
      "$ref": "managed-service-common.v1.schema.json#/$defs/diagnostic"
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materializationHandle",
        "target",
        "revision",
        "sources"
      ],
      "properties": {
        "materializationHandle": {
          "type": "string",
          "pattern": "^msm_[A-Za-z0-9._:-]{1,128}$"
        },
        "target": {
          "$ref": "managed-service-common.v1.schema.json#/$defs/binding"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "binding"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              },
              "binding": {
                "$ref": "managed-service-common.v1.schema.json#/$defs/binding"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "authentication-required",
              "unavailable",
              "failed",
              "cancelled",
              "stale-generation",
              "stale-catalog"
            ]
          }
        }
      },
      "then": {
        "required": [
          "diagnostic"
        ],
        "properties": {
          "diagnostic": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "authenticate",
              "ensure-ready",
              "inspect",
              "restart",
              "dispose",
              "acquire"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "accepted"
            ]
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "projection"
        ],
        "properties": {
          "projection": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "acquire"
          },
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "lease"
        ],
        "properties": {
          "lease": true
        }
      },
      "else": {
        "not": {
          "required": [
            "lease"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "invoke"
          },
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "invocation"
        ],
        "properties": {
          "invocation": true
        }
      },
      "else": {
        "not": {
          "required": [
            "invocation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "materialize"
          },
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "operation",
          "status"
        ]
      },
      "then": {
        "required": [
          "materialization"
        ],
        "properties": {
          "materialization": true
        }
      },
      "else": {
        "properties": {
          "materialization": true
        },
        "not": {
          "required": [
            "materialization"
          ]
        }
      }
    }
  ]
}
