{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-certification.v2.schema.json",
  "title": "CordisX Marketplace Certification Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "level",
    "identity",
    "eligibilityCeiling",
    "reviewPolicy",
    "reviewedAt",
    "expiresAt",
    "reviewer",
    "status",
    "label",
    "description"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-certification.v2.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "level": { "const": "cordisx-certified" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "canonicalSource",
        "packageName",
        "version",
        "downloadUrl",
        "integrity",
        "sourceEvidence"
      ],
      "properties": {
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "canonicalSource": { "const": "https://code.byted.org/fe/cordisx-plugins" },
        "packageName": {
          "type": "string",
          "pattern": "^@byted/cordisx-plugin-[a-z0-9][a-z0-9._-]*$",
          "maxLength": 214
        },
        "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+$",
          "maxLength": 2048
        },
        "integrity": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/digest" },
        "sourceEvidence": { "$ref": "#/$defs/sourceEvidence" }
      }
    },
    "eligibilityCeiling": { "$ref": "#/$defs/eligibilityCeiling" },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "cordisx-marketplace-review" },
        "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" }
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "evidenceRef"],
      "properties": {
        "authority": { "const": "byted.cordisx-marketplace.codeowners/v1" },
        "evidenceRef": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://code\\.byted\\.org/fe/cordisx-marketplace/(?:merge_requests/[1-9][0-9]*|commit/[a-f0-9]{40})$",
          "maxLength": 2048
        }
      }
    },
    "status": { "enum": ["active", "revoked", "expired"] },
    "revokedAt": { "type": "string", "format": "date-time" },
    "label": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
    "description": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" }
  },
  "$defs": {
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceCommit", "mergeRequest", "mergeCommit"],
      "properties": {
        "repository": { "const": "https://code.byted.org/fe/cordisx-plugins" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "mergeRequest": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://code\\.byted\\.org/fe/cordisx-plugins/merge_requests/[1-9][0-9]*$",
          "maxLength": 2048
        },
        "mergeCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "eligibilityCeiling": {
      "const": {
        "capability": "ui.extension-points.render",
        "scope": {
          "extensionPoints": ["manager.settings.navigation-items", "manager.content"]
        }
      }
    }
  }
}
