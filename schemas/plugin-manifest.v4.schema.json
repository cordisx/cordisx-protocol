{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v4.schema.json",
  "title": "CordisX Runtime Plugin Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "capabilities", "services"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v4.schema.json"
    },
    "schemaVersion": { "const": 4 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capabilities": {
      "type": "array",
      "maxItems": 27,
      "items": { "$ref": "#/$defs/capabilityDeclaration" }
    },
    "services": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/serviceDeclaration" }
    }
  },
  "$defs": {
    "capabilityName": {
      "enum": [
        "models.read",
        "tasks.catalog.read",
        "tasks.content.read",
        "tasks.create",
        "tasks.control",
        "turns.submit",
        "turns.control",
        "agents.create",
        "agents.resume",
        "agents.get",
        "agents.message.submit",
        "agents.message.cancel",
        "agents.cancel",
        "agents.live.subscribe",
        "sessions.get",
        "sessions.read",
        "sessions.subscribe",
        "approvals.request",
        "approvals.answer",
        "channel.accounts.read",
        "channel.accounts.connect",
        "channel.events.receive",
        "channel.events.subscribe",
        "channel.messages.send",
        "channel.bindings.read",
        "channel.bindings.write",
        "channel.attachments.read"
      ]
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "platformSessionRef": {
      "$ref": "platform-session.v1.schema.json#/$defs/sessionRef"
    },
    "agentSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": { "const": "*" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/providerId" }
        },
        "cwdRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:/.*|[A-Za-z]:[\\\\/].*|\\\\\\\\.+)$"
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platformSessionRef" }
        },
        "sessionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agentSessionId" }
        },
        "channelAccounts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/accountRef" }
        },
        "channelTenants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" }
        },
        "channelConversations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/conversationRef" }
        },
        "channelUsers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/userRef" }
        }
      }
    },
    "rationaleTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "namespace": { "$ref": "ui-common.v1.schema.json#/$defs/reference" },
        "key": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "additionalProperties": { "$ref": "ui-common.v1.schema.json#/$defs/scalar" }
        },
        "fallback": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "rationaleBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "namespace": { "$ref": "ui-common.v1.schema.json#/$defs/reference" },
        "key": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "params": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "additionalProperties": { "$ref": "ui-common.v1.schema.json#/$defs/scalar" }
        },
        "fallback": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "feature", "deniedBehavior"],
      "properties": {
        "title": { "$ref": "#/$defs/rationaleTitle" },
        "description": { "$ref": "#/$defs/rationaleBody" },
        "feature": { "$ref": "#/$defs/rationaleBody" },
        "deniedBehavior": { "$ref": "#/$defs/rationaleBody" }
      }
    },
    "securityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataUse", "retention", "externalTransfer"],
      "properties": {
        "dataUse": { "enum": ["ephemeral", "profile-persistent", "external-service"] },
        "retention": { "enum": ["none", "runtime", "profile"] },
        "externalTransfer": { "type": "boolean" }
      }
    },
    "capabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "scope"],
      "properties": {
        "name": { "$ref": "#/$defs/capabilityName" },
        "required": { "type": "boolean" },
        "rationale": { "$ref": "#/$defs/rationale" },
        "security": { "$ref": "#/$defs/securityDeclaration" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "serviceConfigDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "schema", "configApplies"],
          "properties": {
            "kind": { "const": "host" },
            "schema": {
              "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-service-config.v1.schema.json"
            },
            "configApplies": { "const": "restart" }
          }
        }
      ]
    },
    "serviceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entry", "configuration"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "kind": { "const": "channel-adapter" },
        "entry": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:cjs|mjs|js)$"
        },
        "configuration": { "$ref": "#/$defs/serviceConfigDeclaration" }
      }
    }
  }
}
