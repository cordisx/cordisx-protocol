{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-conversation-detail.v1.schema.json",
  "title": "channel-manager-conversation-detail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "profileId",
    "hostGeneration",
    "snapshotRevision",
    "conversation"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-manager-conversation-detail/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hostGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "conversation": {
      "$ref": "channel-manager-conversations.v1.schema.json#/$defs/conversation"
    }
  }
}
