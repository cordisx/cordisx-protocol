{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-authorization-decision.v7.schema.json",
  "title": "CordisX Deferred Optional Permission Authorization Decision v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "origin",
    "planId",
    "operation",
    "profileId",
    "identity",
    "binding",
    "decisions"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-authorization-decision.v7.schema.json"
    },
    "schemaVersion": {
      "const": 7
    },
    "origin": {
      "enum": [
        "explicit-user",
        "host-no-decision",
        "bundle-policy"
      ]
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation": {
      "enum": [
        "install",
        "update",
        "enable",
        "runtime"
      ]
    },
    "profileId": {
      "$ref": "permission-common.v4.schema.json#/$defs/profileId"
    },
    "identity": {
      "$ref": "permission-common.v4.schema.json#/$defs/identity"
    },
    "binding": {
      "$ref": "permission-common.v4.schema.json#/$defs/binding"
    },
    "decisions": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "scope",
          "securityFingerprint",
          "decision"
        ],
        "properties": {
          "capability": {
            "$ref": "permission-common.v4.schema.json#/$defs/capability"
          },
          "scope": {
            "$ref": "permission-common.v4.schema.json#/$defs/scope"
          },
          "securityFingerprint": {
            "$ref": "permission-common.v4.schema.json#/$defs/securityFingerprint"
          },
          "decision": {
            "$ref": "permission-common.v4.schema.json#/$defs/decision"
          }
        },
        "allOf": [
          {
            "$ref": "permission-common.v4.schema.json#/$defs/capabilityScopeFence"
          },
          {
            "if": {
              "properties": {
                "capability": {
                  "const": "ui.host-dom.modify"
                }
              },
              "required": [
                "capability"
              ]
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "allow-once",
                    "deny-once",
                    "deny-persistent"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "host-no-decision"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "decisions": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "explicit-user"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "decisions": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "bundle-policy"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "decisions": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
