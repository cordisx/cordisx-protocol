{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v11.schema.json",
  "title": "CordisX Runtime Plugin Manifest v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "capabilities",
    "services"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v11.schema.json"
    },
    "schemaVersion": {
      "const": 11
    },
    "id": {
      "$ref": "plugin-manifest.v10.schema.json#/properties/id"
    },
    "name": {
      "$ref": "plugin-manifest.v10.schema.json#/properties/name"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 37,
      "items": {
        "oneOf": [
          {
            "$ref": "plugin-manifest.v10.schema.json#/properties/capabilities/items"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "required",
              "scope"
            ],
            "properties": {
              "name": {
                "const": "usage.read"
              },
              "required": {
                "type": "boolean"
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile"
                ],
                "properties": {
                  "profile": {
                    "const": "current"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "services": {
      "$ref": "plugin-manifest.v10.schema.json#/properties/services"
    }
  }
}
