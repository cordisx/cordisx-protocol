{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-thread-history-request.v1.schema.json",
  "title": "Channel thread history request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "conversationId", "kind", "threadId", "anchorMessageId"],
  "properties": {
    "account": { "$ref": "channel-remote-history-request.v1.schema.json#/properties/account" },
    "conversationId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "kind": { "enum": ["direct", "group"] },
    "threadId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "anchorMessageId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
    "pageToken": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000\\r\\n]+$" },
    "order": { "enum": ["asc", "desc"] }
  }
}
