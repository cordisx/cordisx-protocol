{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/http-connection.v1.schema.json",
  "title": "Owner-bound HTTP connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "origin",
    "credential"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.http-connection/v1"
    },
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128
    },
    "origin": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^/?#@]+$"
    },
    "credential": {
      "enum": [
        "none",
        "bearer"
      ]
    }
  }
}
