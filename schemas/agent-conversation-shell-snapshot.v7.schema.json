{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v7.schema.json",
  "title": "CordisX Agent Conversation Shell Snapshot v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "binding",
    "generation",
    "snapshotSequence",
    "selection",
    "items",
    "composer",
    "headerActions"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v7.schema.json"
    },
    "contract": {
      "const": "cordisx.agent-conversation-shell-snapshot/v7"
    },
    "schemaVersion": {
      "const": 7
    },
    "binding": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/bindingRef"
    },
    "generation": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/generation"
    },
    "snapshotSequence": {
      "type": "integer",
      "minimum": 0
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "composer": {
      "$ref": "#/$defs/composer"
    },
    "headerActions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/action"
      }
    }
  },
  "$defs": {
    "roomDescription": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "empty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "text"
          ],
          "properties": {
            "state": {
              "const": "present"
            },
            "text": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
            }
          }
        }
      ]
    },
    "participant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participantId",
            "role",
            "displayName"
          ],
          "properties": {
            "participantId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            },
            "role": {
              "enum": [
                "human",
                "system"
              ]
            },
            "displayName": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
            },
            "avatar": {
              "$ref": "agent-avatar.v1.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participantId",
            "role",
            "displayName"
          ],
          "properties": {
            "participantId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            },
            "role": {
              "const": "agent"
            },
            "displayName": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
            },
            "avatar": {
              "$ref": "agent-avatar.v1.schema.json"
            },
            "agentIdentity": {
              "$ref": "agents-common.v1.schema.json#/$defs/definitionIdentity"
            }
          }
        }
      ]
    },
    "activeRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "memberId",
        "runId",
        "sessionId",
        "lifecycle"
      ],
      "properties": {
        "participantId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "memberId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "runId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sessionId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/sessionId"
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "enum": [
                "active",
                "running",
                "waiting",
                "attention"
              ]
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "details": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/agentDetailReference"
        }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-room"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "roomId",
            "title",
            "multiParticipant",
            "participantPresentation",
            "participants"
          ],
          "properties": {
            "kind": {
              "const": "room"
            },
            "roomId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            },
            "title": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
            },
            "description": {
              "$ref": "#/$defs/roomDescription"
            },
            "secondary": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
            },
            "multiParticipant": {
              "type": "boolean"
            },
            "participantPresentation": {
              "enum": [
                "none",
                "host-initials"
              ]
            },
            "participants": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/participant"
              }
            },
            "activeRuns": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/activeRun"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "multiParticipant": {
                    "const": false
                  }
                },
                "required": [
                  "multiParticipant"
                ]
              },
              "then": {
                "properties": {
                  "participantPresentation": {
                    "const": "none"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
        }
      }
    },
    "reactionValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "emoji"
          ],
          "properties": {
            "kind": {
              "const": "emoji"
            },
            "emoji": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "token"
          ],
          "properties": {
            "kind": {
              "const": "semantic"
            },
            "token": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,31}$"
            }
          }
        }
      ]
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reactionId",
        "actorParticipantId",
        "value",
        "state"
      ],
      "properties": {
        "reactionId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "actorParticipantId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "value": {
          "$ref": "#/$defs/reactionValue"
        },
        "state": {
          "enum": [
            "pending",
            "completed",
            "failed"
          ]
        }
      }
    },
    "memberPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "sequence",
        "participantId",
        "memberId",
        "runId",
        "sessionId",
        "state",
        "retryable"
      ],
      "properties": {
        "kind": {
          "const": "member-presence"
        },
        "itemId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "participantId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "memberId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "runId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sessionId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/sessionId"
        },
        "state": {
          "enum": [
            "inviting",
            "creating",
            "joined",
            "ready",
            "failed"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "diagnostic": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
        },
        "retry": {
          "$ref": "ui-common.v1.schema.json#/$defs/commandReference"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "retry"
            ],
            "properties": {
              "retry": true
            }
          },
          "then": {
            "properties": {
              "state": {
                "const": "failed"
              },
              "retryable": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "approvalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "command"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "command": {
          "$ref": "ui-common.v1.schema.json#/$defs/commandReference"
        }
      }
    },
    "approvalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "memberId",
        "identity"
      ],
      "properties": {
        "participantId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "memberId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "identity": {
          "$ref": "approval-common.v2.schema.json#/$defs/exactDefinitionIdentity"
        }
      }
    },
    "approvalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "sequence",
        "participantId",
        "memberId",
        "runId",
        "sessionId",
        "approvalId",
        "approvalKind",
        "requester",
        "authority",
        "reason",
        "state",
        "actions"
      ],
      "properties": {
        "kind": {
          "const": "approval"
        },
        "itemId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "participantId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "memberId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "runId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sessionId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/sessionId"
        },
        "agentGeneration": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/agentGeneration"
        },
        "approvalId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "approvalKind": {
          "enum": [
            "command",
            "file-change",
            "external-action",
            "other"
          ]
        },
        "requester": {
          "$ref": "approval-common.v2.schema.json#/$defs/exactDefinitionIdentity"
        },
        "authority": {
          "$ref": "#/$defs/approvalAuthority"
        },
        "authorityBinding": {
          "$ref": "approval-common.v2.schema.json#/$defs/agentBinding"
        },
        "reason": {
          "$ref": "approval-common.v2.schema.json#/$defs/reason"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "cancelled",
            "failed"
          ]
        },
        "diagnostic": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
        },
        "actions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/approvalAction"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "agentGeneration",
              "authorityBinding"
            ],
            "properties": {
              "agentGeneration": true,
              "authorityBinding": true,
              "actions": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "object",
                    "properties": {
                      "decision": { "const": "approve" }
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "decision": { "const": "reject" }
                    }
                  }
                ],
                "items": false
              },
              "diagnostic": false
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "denied",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "authorityBinding": false,
              "actions": {
                "type": "array",
                "maxItems": 0
              },
              "diagnostic": false
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "diagnostic"
            ],
            "properties": {
              "authorityBinding": false,
              "actions": {
                "type": "array",
                "maxItems": 0
              },
              "diagnostic": true
            }
          }
        }
      ]
    },
    "messageSemantic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose"
          ],
          "properties": {
            "purpose": {
              "const": "conversation"
            },
            "correlation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requestMessageId"
              ],
              "properties": {
                "requestMessageId": {
                  "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/messageId"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "correlation",
            "participantId",
            "memberId",
            "runId"
          ],
          "properties": {
            "purpose": {
              "const": "member-self-introduction"
            },
            "correlation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sessionId",
                "requestMessageId"
              ],
              "properties": {
                "sessionId": {
                  "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/sessionId"
                },
                "requestMessageId": {
                  "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/messageId"
                }
              }
            },
            "participantId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            },
            "memberId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            },
            "runId": {
              "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose"
          ],
          "properties": {
            "purpose": {
              "const": "chatroom-acknowledgement"
            }
          }
        }
      ]
    },
    "messageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "messageId",
        "sequence",
        "source",
        "semantic",
        "author",
        "body",
        "reactions",
        "timestamp",
        "deliveryState",
        "runState",
        "ariaLive",
        "actions"
      ],
      "properties": {
        "kind": {
          "const": "message"
        },
        "itemId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "messageId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/messageId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/messageSource"
        },
        "semantic": {
          "$ref": "#/$defs/messageSemantic"
        },
        "author": {
          "$ref": "#/$defs/participant"
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/textBlock"
          }
        },
        "reactions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reaction"
          }
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "deliveryState": {
          "enum": [
            "pending",
            "sent",
            "delivered",
            "failed"
          ]
        },
        "runState": {
          "enum": [
            "idle",
            "running",
            "stopped",
            "failed"
          ]
        },
        "ariaLive": {
          "enum": [
            "off",
            "polite"
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/action"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "session-event"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "semantic": {
                "type": "object",
                "properties": {
                  "purpose": {
                    "enum": [
                      "conversation",
                      "member-self-introduction"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "chatroom-acknowledgement"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "semantic": {
                "type": "object",
                "properties": {
                  "purpose": {
                    "const": "chatroom-acknowledgement"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "semantic"
            ],
            "properties": {
              "semantic": {
                "type": "object",
                "required": [
                  "purpose"
                ],
                "properties": {
                  "purpose": {
                    "const": "member-self-introduction"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "session-event"
                  }
                }
              },
              "author": {
                "type": "object",
                "required": [
                  "role",
                  "agentIdentity"
                ],
                "properties": {
                  "role": {
                    "const": "agent"
                  },
                  "agentIdentity": true
                }
              }
            }
          }
        }
      ]
    },
    "statusItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "sequence",
        "label",
        "state",
        "ariaLive"
      ],
      "properties": {
        "kind": {
          "const": "status"
        },
        "itemId": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/displayText"
        },
        "state": {
          "enum": [
            "info",
            "working",
            "warning",
            "error"
          ]
        },
        "ariaLive": {
          "enum": [
            "off",
            "polite"
          ]
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/messageItem"
        },
        {
          "$ref": "#/$defs/statusItem"
        },
        {
          "$ref": "#/$defs/memberPresence"
        },
        {
          "$ref": "#/$defs/approvalItem"
        }
      ]
    },
    "composer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "placeholder",
        "disabled",
        "submit",
        "shortcutPolicy"
      ],
      "properties": {
