{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/raster-image-snapshot.v1.schema.json",
  "title": "CordisX bounded raster image snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "mediaType", "encoding", "data", "width", "height"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/raster-image-snapshot.v1.schema.json" },
    "contract": { "const": "cordisx.raster-image-snapshot/v1" },
    "schemaVersion": { "const": 1 },
    "mediaType": { "const": "image/png" },
    "encoding": { "const": "base64" },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 4,
      "maxLength": 349528,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "width": { "type": "integer", "minimum": 1, "maximum": 256 },
    "height": { "type": "integer", "minimum": 1, "maximum": 256 }
  }
}
