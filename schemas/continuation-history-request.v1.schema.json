{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordisx.dev/schemas/continuation-history-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.continuation-history-request/v1"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  }
}
