{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-common.v1.schema.json",
  "title": "CordisX Channel Manager Common Types v1",
  "$defs": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "opaqueToken": {
      "type": "string",
      "pattern": "^chm1_[A-Za-z0-9_-]{43}$",
      "description": "Host-issued opaque token: version prefix plus 256-bit MAC or random capability encoding."
    },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "hostGeneration": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "connectionTarget": {
      "type": "object", "additionalProperties": false, "required": ["kind", "connectionToken"],
      "properties": { "kind": { "const": "connection" }, "connectionToken": { "$ref": "#/$defs/opaqueToken" } }
    },
    "connectionDraftTarget": {
      "type": "object", "additionalProperties": false, "required": ["kind", "connectionDraftToken"],
      "properties": { "kind": { "const": "connection-draft" }, "connectionDraftToken": { "$ref": "#/$defs/opaqueToken" } }
    },
    "credentialCaptureTarget": {
      "type": "object", "additionalProperties": false, "required": ["kind", "captureToken"],
      "properties": { "kind": { "const": "credential-capture" }, "captureToken": { "$ref": "#/$defs/opaqueToken" } }
    },
    "bindingTarget": {
      "type": "object", "additionalProperties": false, "required": ["kind", "bindingToken", "bindingRevision"],
      "properties": { "kind": { "const": "binding" }, "bindingToken": { "$ref": "#/$defs/opaqueToken" }, "bindingRevision": { "type": "integer", "minimum": 1 } }
    },
    "logTarget": {
      "type": "object", "additionalProperties": false, "required": ["kind", "connectionToken"],
      "properties": { "kind": { "const": "log" }, "connectionToken": { "$ref": "#/$defs/opaqueToken" } }
    },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/connectionTarget" },
        { "$ref": "#/$defs/connectionDraftTarget" },
        { "$ref": "#/$defs/credentialCaptureTarget" },
        { "$ref": "#/$defs/bindingTarget" },
        { "$ref": "#/$defs/logTarget" }
      ]
    },
    "connectionDraft": {
      "type": "object", "additionalProperties": false, "required": ["displayName", "adapterKind", "credentialDraftToken"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "adapterKind": { "$ref": "channel-service-config.v1.schema.json#/$defs/adapterKind" },
        "credentialDraftToken": { "$ref": "#/$defs/opaqueToken" },
        "selectors": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": { "enum": ["direct", "group", "mentions", "replies"] }
        }
      }
    },
    "logQuery": {
      "type": "object", "additionalProperties": false, "required": ["limit"],
      "properties": {
        "cursor": { "$ref": "#/$defs/opaqueToken" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "levels": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["debug", "info", "warn", "error"] } }
      }
    },
    "operation": {
      "enum": ["credential.capture", "connection.create", "connection.rotate-credential", "connection.enable", "connection.disable", "connection.reconnect", "binding.open", "binding.archive", "binding.restore", "binding.unbind", "logs.query", "logs.export"]
    },
    "resultCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9._-]*$" }
  }
}
