{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-official.v2.schema.json",
  "title": "CordisX Marketplace Official Publisher Record v2",
  "description": "Publisher identity only. Official status never grants a capability or changes a permission decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "designation",
    "identity",
    "verificationPolicy",
    "verifiedAt",
    "reviewer",
    "status",
    "label",
    "description"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-official.v2.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "designation": { "const": "cordisx-official" },
    "identity": { "$ref": "#/$defs/internalBytedIdentity" },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "cordisx-official-publisher" },
        "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" }
      }
    },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "evidenceRef"],
      "properties": {
        "authority": { "const": "byted.cordisx-marketplace.codeowners/v1" },
        "evidenceRef": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://code\\.byted\\.org/fe/cordisx-marketplace/(?:merge_requests/[1-9][0-9]*|commit/[a-f0-9]{40})$",
          "maxLength": 2048
        }
      }
    },
    "status": { "enum": ["active", "revoked"] },
    "revokedAt": { "type": "string", "format": "date-time" },
    "label": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
    "description": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" }
  },
  "$defs": {
    "internalBytedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "canonicalSource", "publisherIdentity", "packageNamespace", "packageName"],
      "properties": {
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "canonicalSource": { "const": "https://code.byted.org/fe/cordisx-plugins" },
        "publisherIdentity": { "const": "npm:@byted" },
        "packageNamespace": { "const": "@byted" },
        "packageName": {
          "type": "string",
          "pattern": "^@byted/cordisx-plugin-[a-z0-9][a-z0-9._-]*$",
          "maxLength": 214
        }
      }
    }
  }
}
