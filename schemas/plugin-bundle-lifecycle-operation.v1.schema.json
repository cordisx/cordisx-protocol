{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-lifecycle-operation.v1.schema.json",
  "title": "CordisX Plugin Bundle Lifecycle Operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "profileId", "expectedRevision", "expectedPluginRevision", "runtimeGeneration", "operation"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-lifecycle-operation.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "expectedRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "expectedPluginRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "runtimeGeneration": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/generation" },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source"],
          "properties": {
            "kind": { "const": "inspect-source" },
            "source": { "$ref": "plugin-package-source.v1.schema.json#/$defs/source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidateId", "impactToken", "bundlePermissions", "pluginOverrides"],
          "properties": {
            "kind": { "enum": ["install", "update"] },
            "candidateId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
            "bundlePermissions": {
              "type": "array",
              "maxItems": 1024,
              "items": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/permissionAssignment" }
            },
            "pluginOverrides": {
              "type": "array",
              "maxItems": 1024,
              "items": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/pluginPermissionOverride" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bundleId", "impactToken"],
          "properties": {
            "kind": { "enum": ["enable", "disable", "uninstall"] },
            "bundleId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bundleId", "bundlePermissions", "pluginOverrides", "clearPluginOverrides", "impactToken"],
          "properties": {
            "kind": { "const": "set-permissions" },
            "bundleId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "bundlePermissions": {
              "type": "array",
              "maxItems": 1024,
              "items": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/permissionAssignment" }
            },
            "pluginOverrides": {
              "type": "array",
              "maxItems": 1024,
              "items": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/pluginPermissionOverride" }
            },
            "clearPluginOverrides": {
              "type": "array",
              "maxItems": 1024,
              "items": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/pluginPermissionReference" }
            },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bundleId", "pluginId", "enabled", "impactToken"],
          "properties": {
            "kind": { "const": "set-optional-member" },
            "bundleId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "enabled": { "type": "boolean" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bundleId", "pluginId", "impactToken"],
          "properties": {
            "kind": { "const": "adopt-member" },
            "bundleId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        }
      ]
    }
  }
}
