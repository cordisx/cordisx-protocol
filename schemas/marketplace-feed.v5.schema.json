{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-feed.v5.schema.json",
  "title": "CordisX Trusted Marketplace Feed v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "trust", "fallbackLocale", "name", "description", "homepage", "plugins", "official", "certifications"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-feed.v5.schema.json" },
    "schemaVersion": { "const": 5 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "trust": { "type": "object", "additionalProperties": false, "required": ["authority", "root", "grantModel", "cryptographicAttestation"], "properties": { "authority": { "const": "cordisx.marketplace.codeowners/v1" }, "root": { "type": "string", "format": "uri", "pattern": "^https://[^?#]+$", "maxLength": 2048 }, "grantModel": { "const": "protected-merge-chain-v1" }, "cryptographicAttestation": { "const": "unsupported" } } },
    "fallbackLocale": { "$ref": "#/$defs/locale" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 280 },
    "localizations": { "type": "object", "maxProperties": 32, "propertyNames": { "$ref": "#/$defs/locale" }, "additionalProperties": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 }, "description": { "type": "string", "minLength": 1, "maxLength": 280 } } } },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "plugins": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-plugin.v5.schema.json" } },
    "official": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-official.v1.schema.json" } },
    "certifications": { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/marketplace-certification.v1.schema.json" } }
  },
  "$defs": { "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "maxLength": 48 } }
}
