{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-config-common.v1.schema.json",
  "title": "CordisX Manager Content Config Common Definitions v1",
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "generation": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "identity", "scope", "declarationId", "namespace"],
      "properties": {
        "bindingId": { "$ref": "#/$defs/opaqueId" },
        "identity": { "$ref": "plugin-config-common.v2.schema.json#/$defs/identity" },
        "scope": { "$ref": "plugin-config-common.v2.schema.json#/$defs/scope" },
        "declarationId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "namespace": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "const": "set" },
            "path": { "$ref": "plugin-config-common.v2.schema.json#/$defs/fieldPath" },
            "value": { "$ref": "ui-common.v1.schema.json#/$defs/jsonValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "unset" },
            "path": { "$ref": "plugin-config-common.v2.schema.json#/$defs/fieldPath" }
          }
        }
      ]
    },
    "operations": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/operation" } },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "path": { "$ref": "plugin-config-common.v2.schema.json#/$defs/fieldPath" },
        "code": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "message": {
          "allOf": [
            { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
            { "type": "object", "required": ["fallback"], "properties": { "fallback": true } }
          ]
        }
      }
    },
    "validation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "unvalidated" } } },
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "valid" } } },
        { "type": "object", "additionalProperties": false, "required": ["state", "issues"], "properties": { "state": { "const": "invalid" }, "issues": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/validationIssue" } } } }
      ]
    },
    "defaultScalar": {
      "oneOf": [
        { "type": "string", "maxLength": 4096 },
        { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "missingDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": { "$ref": "plugin-config-common.v2.schema.json#/$defs/fieldPath" },
        "value": { "$ref": "#/$defs/defaultScalar" }
      }
    },
    "defaultMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fields"],
      "properties": {
        "mode": { "const": "missing-only" },
        "fields": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/missingDefault" } }
      }
    }
  }
}
