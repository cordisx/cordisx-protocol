{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/outlet.v1.schema.json",
  "title": "CordisX Host Outlet Declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "authority", "scope", "preferredPlacement", "contextPolicy"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/outlet.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "id": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
    },
    "authority": { "const": "host-adapter" },
    "scope": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
    },
    "preferredPlacement": { "enum": ["fixed", "absolute", "portal"] },
    "contextPolicy": { "enum": ["generation", "semantic"] }
  }
}
