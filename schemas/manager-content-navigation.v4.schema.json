{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-navigation.v4.schema.json",
  "title": "CordisX Manager Content Navigation Declaration v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "route", "header"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-navigation.v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "route": { "$ref": "manager-content-navigation.v1.schema.json#/$defs/sameOwnerRouteReference" },
    "parentRoute": { "$ref": "manager-content-navigation.v1.schema.json#/$defs/sameOwnerRouteReference" },
    "header": { "$ref": "manager-content-navigation.v1.schema.json#/$defs/headerDescription" },
    "subject": { "$ref": "manager-content-navigation.v3.schema.json#/$defs/subject" },
    "recordSummary": { "$ref": "manager-content-navigation.v3.schema.json#/$defs/recordSummary" },
    "tabs": { "type": "array", "maxItems": 12, "items": { "$ref": "manager-content-navigation.v3.schema.json#/$defs/tabDescription" } },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace"],
      "properties": {
        "kind": { "const": "plugin-config-form" },
        "namespace": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "defaultMaterialization": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/defaultMaterialization" }
      }
    }
  }
}
