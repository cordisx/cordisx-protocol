{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-event-page.v1.schema.json",
  "title": "CordisX Session Event Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "sessionId", "sessionGeneration", "afterSeq", "snapshotSeq", "events", "nextAfterSeq", "hasMore"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-event-page.v1.schema.json" },
    "contract": { "const": "cordisx.session-event-page/v1" },
    "schemaVersion": { "const": 1 },
    "sessionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "sessionGeneration": { "$ref": "session-common.v1.schema.json#/$defs/generation" },
    "afterSeq": { "$ref": "session-common.v1.schema.json#/$defs/cursor" },
    "snapshotSeq": { "$ref": "session-common.v1.schema.json#/$defs/cursor" },
    "events": { "type": "array", "maxItems": 1000, "items": { "$ref": "session-event.v1.schema.json" } },
    "nextAfterSeq": { "$ref": "session-common.v1.schema.json#/$defs/cursor" },
    "hasMore": { "type": "boolean" }
  }
}
