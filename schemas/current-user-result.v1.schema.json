{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/current-user-result.v1.schema.json",
  "title": "Current Host user display profile result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profile"],
      "properties": {
        "status": { "const": "available" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject"],
          "properties": {
            "subject": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
            "avatar": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^data:image/(?:png|jpeg|webp);base64,(?=[A-Za-z0-9+/])(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": { "enum": ["signed-out", "host-unavailable", "generation-retired"] }
      }
    }
  ]
}
