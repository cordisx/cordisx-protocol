{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-snapshot.v1.schema.json",
  "title": "CordisX Session Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "sessionId", "sessionGeneration", "header", "snapshotSeq"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-snapshot.v1.schema.json" },
    "contract": { "const": "cordisx.session-snapshot/v1" },
    "schemaVersion": { "const": 1 },
    "sessionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "sessionGeneration": { "$ref": "session-common.v1.schema.json#/$defs/generation" },
    "header": { "$ref": "session-common.v1.schema.json#/$defs/sessionHeader" },
    "snapshotSeq": { "$ref": "session-common.v1.schema.json#/$defs/cursor" }
  }
}
