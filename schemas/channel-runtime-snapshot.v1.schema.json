{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-runtime-snapshot.v1.schema.json",
  "title": "CordisX Redacted Channel Runtime Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "observedAt", "accounts"],
  "properties": {
    "contract": { "const": "cordisx.channel-runtime-snapshot/v1" },
    "schemaVersion": { "const": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "accounts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/accountSnapshot" }
    }
  },
  "$defs": {
    "implementationStatus": {
      "enum": ["implemented", "verified", "experimental", "unavailable", "planned"]
    },
    "queueSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "retrying", "deadLetter"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "retrying": { "type": "integer", "minimum": 0 },
        "deadLetter": { "type": "integer", "minimum": 0 }
      }
    },
    "accountSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "adapterKind",
        "implementationStatus",
        "connectionState",
        "secretState",
        "generation",
        "lastGoodRevision",
        "inbound",
        "outbound"
      ],
      "properties": {
        "ref": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" },
        "adapterKind": {
          "enum": [
            "simulator",
            "feishu",
            "lark",
            "wecom-intelligent-bot",
            "wecom-enterprise-app",
            "wecom-message-push",
            "wechat-service"
          ]
        },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "connectionState": {
          "enum": ["disabled", "starting", "ready", "retrying", "unavailable", "stopped"]
        },
        "secretState": { "enum": ["missing", "ready", "unavailable"] },
        "generation": { "type": "integer", "minimum": 1 },
        "lastGoodRevision": { "type": "integer", "minimum": 0 },
        "cursorUpdatedAt": { "type": "string", "format": "date-time" },
        "lastErrorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
        },
        "inbound": { "$ref": "#/$defs/queueSnapshot" },
        "outbound": { "$ref": "#/$defs/queueSnapshot" }
      }
    }
  }
}
