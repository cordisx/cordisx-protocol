{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-subscription-close.v6.schema.json",
  "title": "CordisX Agent Conversation Shell Subscription Close v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "subscriptionId",
    "binding",
    "generation",
    "status",
    "code"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-subscription-close.v6.schema.json"
    },
    "contract": {
      "const": "cordisx.agent-conversation-shell-subscription-close/v6"
    },
    "schemaVersion": {
      "const": 6
    },
    "subscriptionId": {
      "$ref": "agent-conversation-shell-common.v6.schema.json#/$defs/opaqueId"
    },
    "binding": {
      "$ref": "agent-conversation-shell-common.v6.schema.json#/$defs/bindingRef"
    },
    "generation": {
      "$ref": "agent-conversation-shell-common.v6.schema.json#/$defs/generation"
    },
    "status": {
      "const": "closed"
    },
    "code": {
      "enum": [
        "unsubscribed",
        "explicit",
        "owner-disposed",
        "generation-replaced",
        "permission-revoked",
        "connection-replaced",
        "observer-failed"
      ]
    }
  }
}
