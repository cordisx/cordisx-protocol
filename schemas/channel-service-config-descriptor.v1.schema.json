{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-service-config-descriptor.v1.schema.json",
  "title": "CordisX Redacted Channel Connection Configuration Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "identity",
    "scope",
    "schema",
    "revision",
    "lastGoodRevision",
    "configApplies",
    "writable",
    "configuration"
  ],
  "properties": {
    "contract": { "const": "cordisx.channel-service-config-descriptor/v1" },
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pluginId", "serviceId"],
      "properties": {
        "source": { "$ref": "extension-point-common.v1.schema.json#/$defs/canonicalSource" },
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "serviceId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "generation"],
      "properties": {
        "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "schema": { "$ref": "service-config-common.v1.schema.json#/$defs/schema" },
    "revision": { "type": "integer", "minimum": 0 },
    "lastGoodRevision": { "type": "integer", "minimum": 0 },
    "configApplies": { "const": "restart" },
    "writable": { "type": "boolean" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "schemaVersion", "connections"],
      "properties": {
        "contract": { "const": "cordisx.channel-service-config/v1" },
        "schemaVersion": { "const": 1 },
        "connections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/connectionProjection" }
        }
      }
    }
  },
  "$defs": {
    "connectionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "adapterKind", "enabled", "transport", "secretState"],
      "properties": {
        "ref": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" },
        "adapterKind": { "$ref": "channel-service-config.v1.schema.json#/$defs/adapterKind" },
        "enabled": { "type": "boolean" },
        "transport": { "$ref": "channel-service-config.v1.schema.json#/$defs/transport" },
        "secretState": { "enum": ["missing", "ready", "unavailable"] }
      }
    }
  }
}
