{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-target-request.v1.schema.json",
  "title": "CordisX Channel Manager Target Issuance Request v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "schemaVersion", "requestId", "expectedRevision", "profileId", "hostGeneration", "operation", "target"],
  "properties": { "contract": { "const": "cordisx.channel-manager-target-request/v1" }, "schemaVersion": { "const": 1 }, "requestId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/requestId" }, "expectedRevision": { "$ref": "channel-manager-common.v2.schema.json#/$defs/revision" }, "profileId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/profileId" }, "hostGeneration": { "$ref": "channel-manager-common.v2.schema.json#/$defs/hostGeneration" }, "operation": { "$ref": "channel-manager-common.v2.schema.json#/$defs/issuanceOperation" }, "purpose": { "enum": ["create", "rotate"] }, "adapterKind": { "$ref": "channel-service-config.v1.schema.json#/$defs/adapterKind" }, "target": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "root" } } }, { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionTarget" }, { "$ref": "channel-manager-common.v2.schema.json#/$defs/credentialDraftTarget" }] } },
  "allOf": [
    { "if": { "properties": { "operation": { "const": "target.credential.capture.create" } }, "required": ["operation"] }, "then": { "required": ["purpose", "adapterKind"], "properties": { "purpose": { "const": "create" }, "adapterKind": { "not": { "const": "simulator" } }, "target": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "root" } } } } } },
    { "if": { "properties": { "operation": { "const": "target.credential.capture.rotate" } }, "required": ["operation"] }, "then": { "required": ["purpose"], "properties": { "purpose": { "const": "rotate" }, "adapterKind": false, "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionTarget" } } } },
    { "if": { "properties": { "operation": { "const": "target.connection.create" } }, "required": ["operation"] }, "then": { "properties": { "purpose": false, "adapterKind": false, "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/credentialDraftTarget" } } } },
    { "if": { "properties": { "operation": { "const": "target.connection.create.simulator" } }, "required": ["operation"] }, "then": { "required": ["adapterKind"], "properties": { "purpose": false, "adapterKind": { "const": "simulator" }, "target": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "root" } } } } } }
  ]
}
