{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-bound-client-call.v1.schema.json",
  "title": "CordisX Bound Connector Client Call v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "callId", "type"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-bound-client-call.v1.schema.json" },
    "contract": { "const": "cordisx.bound-connector-client-call/v1" },
    "schemaVersion": { "const": 1 },
    "callId": { "$ref": "connector-common.v1.schema.json#/$defs/opaqueHandle" },
    "type": { "enum": ["discover", "execute", "subscribe"] },
    "registration": { "$ref": "connector-common.v1.schema.json#/$defs/registration" },
    "command": { "$ref": "connector-command.v1.schema.json" },
    "afterSequence": { "type": "integer", "minimum": -1 }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "discover" } }, "required": ["type"] }, "then": { "properties": { "registration": false, "command": false, "afterSequence": false } } },
    { "if": { "properties": { "type": { "const": "execute" } }, "required": ["type"] }, "then": { "required": ["registration", "command"], "properties": { "registration": true, "command": true, "afterSequence": false } } },
    { "if": { "properties": { "type": { "const": "subscribe" } }, "required": ["type"] }, "then": { "required": ["registration", "afterSequence"], "properties": { "registration": true, "afterSequence": true, "command": false } } }
  ]
}
