{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/icon-theme-lifecycle-result.v1.schema.json",
  "title": "CordisX Host Icon Theme Lifecycle Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "authority", "requestId", "profileId", "operation", "outcome", "revision", "hostGeneration", "activeProvider"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/icon-theme-lifecycle-result.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "authority": { "const": "host" },
    "requestId": { "$ref": "icon-theme-common.v1.schema.json#/$defs/opaqueId" },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "operation": { "enum": ["register", "select", "dispose", "rollback"] },
    "outcome": { "enum": ["staged", "applied", "conflict", "rejected", "rolled-back", "rollback-failed"] },
    "revision": { "type": "integer", "minimum": 0 },
    "hostGeneration": { "$ref": "icon-theme-common.v1.schema.json#/$defs/generation" },
    "activeProvider": { "$ref": "icon-theme-common.v1.schema.json#/$defs/providerReference" },
    "affectedProviderHandle": { "$ref": "icon-theme-common.v1.schema.json#/$defs/providerHandle" },
    "disposedGeneration": { "$ref": "icon-theme-common.v1.schema.json#/$defs/generation" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "enum": ["stale-revision", "stale-host-generation", "unknown-provider", "stale-provider-generation", "provider-selected", "identity-mismatch", "namespace-conflict", "prepare-failed", "resolution-failed", "invalid-descriptor", "dispose-failed", "rollback-failed"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["conflict", "rejected", "rollback-failed"] } }, "required": ["outcome"] },
      "then": { "required": ["error"], "properties": { "error": true } }
    },
    {
      "if": { "properties": { "outcome": { "enum": ["staged", "applied", "rolled-back"] } }, "required": ["outcome"] },
      "then": { "properties": { "error": false } }
    },
    {
      "if": { "properties": { "operation": { "const": "dispose" }, "outcome": { "const": "applied" } }, "required": ["operation", "outcome"] },
      "then": { "required": ["affectedProviderHandle", "disposedGeneration"], "properties": { "affectedProviderHandle": true, "disposedGeneration": true } }
    },
    {
      "if": { "properties": { "operation": { "const": "rollback" }, "outcome": { "const": "rolled-back" } }, "required": ["operation", "outcome"] },
      "then": { "required": ["affectedProviderHandle"], "properties": { "affectedProviderHandle": true } }
    }
  ]
}
