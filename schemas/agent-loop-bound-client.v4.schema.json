{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-bound-client.v4.schema.json",
  "title": "CordisX Host-injected Bound Agent Loop Client v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "injection", "operations", "lifetime", "subscription", "durableLedger"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-bound-client.v4.schema.json" },
    "contract": { "const": "cordisx.bound-agent-loop-client/v4" },
    "schemaVersion": { "const": 4 },
    "injection": { "const": "host-bound" },
    "operations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["createOrBind", "send", "decideApproval", "requestMemberSelfIntroduction", "cancelMemberSelfIntroduction", "subscribe", "dispose"] }
    },
    "lifetime": { "const": "fiber-owned" },
    "subscription": {
      "type": "object", "additionalProperties": false, "required": ["pages", "unsubscribe", "ownerDispose"],
      "properties": { "pages": { "const": "ordered" }, "unsubscribe": { "const": "explicit" }, "ownerDispose": { "const": "terminates" } }
    },
    "durableLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "scope", "providerAffinity", "survivesClientDispose", "payloadMatch", "retention"],
      "properties": {
        "operationId": { "const": "commandId" },
        "scope": { "const": "owner-provider" },
        "providerAffinity": { "const": "generation-fenced" },
        "survivesClientDispose": { "const": true },
        "payloadMatch": { "const": "structural-exact" },
        "retention": {
          "type": "object", "additionalProperties": false, "required": ["active", "recoveryDays"],
          "properties": { "active": { "const": "logical-task-lifetime" }, "recoveryDays": { "const": 30 } }
        }
      }
    }
  }
}
