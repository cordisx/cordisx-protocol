{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-collection-registration.v1.schema.json",
  "title": "CordisX Manager Collection Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "id", "label", "description", "views", "defaultView", "search"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-collection-registration.v1.schema.json" },
    "contract": { "const": "cordisx.manager-collection-registration/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "label": { "$ref": "manager-collection-common.v1.schema.json#/$defs/displayText" },
    "description": { "$ref": "manager-collection-common.v1.schema.json#/$defs/displayText" },
    "views": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "manager-collection-common.v1.schema.json#/$defs/view" } },
    "defaultView": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "search": { "$ref": "manager-collection-common.v1.schema.json#/$defs/search" }
  }
}
