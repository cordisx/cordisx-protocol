{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle.v1.schema.json",
  "title": "CordisX Explicit Local Plugin Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "version",
    "authors",
    "readme",
    "distribution",
    "members"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "readme": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:md|markdown)$"
    },
    "icon": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:png|webp|svg)$"
    },
    "canonicalSource": {
      "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/canonicalPublicSource"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "signature"],
      "properties": {
        "mode": { "const": "explicit-local-v1" },
        "signature": { "const": "unsupported" }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "required", "enabledByDefault"],
        "properties": {
          "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
          "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
          "path": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
          },
          "required": { "type": "boolean" },
          "enabledByDefault": { "type": "boolean" }
        }
      }
    }
  }
}
