{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/icon-theme-resolution-request.v1.schema.json",
  "title": "CordisX Icon Theme Resolution Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "hostGeneration", "providerHandle", "providerGeneration", "key", "variant", "state"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/icon-theme-resolution-request.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "icon-theme-common.v1.schema.json#/$defs/opaqueId" },
    "hostGeneration": { "$ref": "icon-theme-common.v1.schema.json#/$defs/generation" },
    "providerHandle": { "$ref": "icon-theme-common.v1.schema.json#/$defs/providerHandle" },
    "providerGeneration": { "$ref": "icon-theme-common.v1.schema.json#/$defs/generation" },
    "key": { "$ref": "icon-theme-common.v1.schema.json#/$defs/semanticIconKey" },
    "variant": { "$ref": "icon-theme-common.v1.schema.json#/$defs/variant" },
    "state": { "$ref": "icon-theme-common.v1.schema.json#/$defs/state" }
  }
}
