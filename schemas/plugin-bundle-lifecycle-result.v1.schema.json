{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-lifecycle-result.v1.schema.json",
  "title": "CordisX Plugin Bundle Lifecycle Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "profileId", "operation", "outcome", "revision", "pluginRevision", "runtimeGeneration", "affectedPluginIds", "retainedPluginIds", "removedPluginIds"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-lifecycle-result.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "operation": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/operationKind" },
    "outcome": { "enum": ["planned", "applied", "conflict", "rejected", "rolled-back", "rollback-failed"] },
    "revision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "pluginRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "runtimeGeneration": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/generation" },
    "bundleId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "candidateId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "affectedPluginIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
    },
    "retainedPluginIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
    },
    "removedPluginIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "memberActions", "permissionRequests", "conflicts"],
      "properties": {
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "version", "digest", "authors"],
          "properties": {
            "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
            "digest": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/digest" },
            "authors": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        },
        "memberActions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "version", "action", "reason"],
            "properties": {
              "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
              "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
              "action": { "enum": ["install", "update", "share", "enable", "disable", "retain", "remove", "skip"] },
              "reason": { "enum": ["bundle-required", "bundle-optional", "existing-exact", "direct-claim", "other-bundle-claim", "runtime-dependency", "orphaned"] }
            }
          }
        },
        "permissionRequests": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["permissionId", "pluginId", "capability", "scopeLabel", "required", "defaultPolicy"],
            "properties": {
              "permissionId": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/permissionId" },
              "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
              "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
              "scopeLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
              "required": { "type": "boolean" },
              "defaultPolicy": { "const": "ask" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "code", "message"],
            "properties": {
              "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
              "code": { "enum": ["version-mismatch", "digest-mismatch", "dependency-conflict", "permission-review-required"] },
              "message": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["invalid-source", "invalid-bundle", "stale-revision", "stale-generation", "impact-changed", "version-conflict", "permission-review-required", "operation-unavailable", "apply-failed", "rollback-failed"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
