{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/entity-file.v1.schema.json",
  "title": "CordisX Editable Entity File v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "agentId", "inherit"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/entity-file.v1.schema.json" },
    "contract": { "const": "cordisx.entity-file/v1" },
    "schemaVersion": { "const": 1 },
    "agentId": { "$ref": "entity-common.v1.schema.json#/$defs/localId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 2000 },
    "avatar": { "$ref": "agent-avatar.v1.schema.json#/$defs/agentAvatarRef" },
    "extends": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "agents-common.v1.schema.json#/$defs/definitionIdentity" } },
    "inherit": {
      "type": "object", "additionalProperties": false,
      "required": ["promptSections", "rules", "skills", "tools", "mcpServers", "runtimeDefaults"],
      "properties": {
        "promptSections": { "$ref": "agents-common.v1.schema.json#/$defs/inheritanceMode" },
        "rules": { "$ref": "agents-common.v1.schema.json#/$defs/inheritanceMode" },
        "skills": { "$ref": "agents-common.v1.schema.json#/$defs/inheritanceMode" },
        "tools": { "$ref": "agents-common.v1.schema.json#/$defs/objectInheritanceMode" },
        "mcpServers": { "$ref": "agents-common.v1.schema.json#/$defs/objectInheritanceMode" },
        "runtimeDefaults": { "$ref": "agents-common.v1.schema.json#/$defs/objectInheritanceMode" },
        "avatar": { "enum": ["inherit", "none"] }
      }
    },
    "promptSections": { "type": "array", "maxItems": 64, "items": { "$ref": "entity-common.v1.schema.json#/$defs/promptSection" } },
    "rules": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "agents-common.v1.schema.json#/$defs/identifier" } },
    "skills": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "agents-common.v1.schema.json#/$defs/identifier" } },
    "tools": { "$ref": "agents-common.v1.schema.json#/$defs/filter" },
    "mcpServers": { "$ref": "agents-common.v1.schema.json#/$defs/filter" },
    "runtimeDefaults": { "$ref": "agent-definition.v1.schema.json#/$defs/runtimeDefaults" }
  }
}
