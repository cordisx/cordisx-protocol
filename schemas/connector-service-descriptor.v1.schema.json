{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-service-descriptor.v1.schema.json",
  "title": "CordisX Connector Service Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "connectorId", "protocolVersion", "capabilities"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-service-descriptor.v1.schema.json" },
    "contract": { "const": "cordisx.connector-service-descriptor/v1" },
    "schemaVersion": { "const": 1 },
    "connectorId": { "$ref": "connector-common.v1.schema.json#/$defs/identifier" },
    "protocolVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "connector-common.v1.schema.json#/$defs/capability" }
    }
  }
}
