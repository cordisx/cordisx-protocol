{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v14.schema.json",
  "title": "CordisX Runtime Plugin Manifest v14",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "capabilities", "services"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v14.schema.json" },
    "schemaVersion": { "const": 14 },
    "id": { "$ref": "plugin-manifest.v13.schema.json#/properties/id" },
    "name": { "$ref": "plugin-manifest.v13.schema.json#/properties/name" },
    "capabilities": { "$ref": "plugin-manifest.v13.schema.json#/properties/capabilities" },
    "services": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          { "$ref": "plugin-manifest.v10.schema.json#/$defs/serviceDeclaration" },
          { "$ref": "#/$defs/managedBackendService" }
        ]
      }
    }
  },
  "$defs": {
    "managedBackendService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "entry", "definitionSchema", "runtimeResources", "consumerGrants"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "kind": { "const": "managed-backend" },
        "owner": { "const": "host" },
        "entry": { "$ref": "plugin-manifest.v9.schema.json#/$defs/platformProviderService/properties/entry" },
        "definitionSchema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-definition.v1.schema.json" },
        "consumerGrants": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "operations"],
            "properties": {
              "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
              "operations": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" } }
            }
          }
        },
        "runtimeResources": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "digest", "byteLength"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\./(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!.*[*?\\[\\]{}])[^\\u0000\\\\]+$",
                "maxLength": 512
              },
              "mode": { "enum": ["executable", "data"] },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 67108864
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": { "enum": ["darwin", "linux", "win32"] }
              },
              "architectures": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "enum": ["arm64", "x64"] }
              }
            }
          }
        }
      }
    }
  }
}
