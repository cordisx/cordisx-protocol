{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-log-page.v1.schema.json",
  "title": "CordisX Channel Manager Safe Log Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "requestId", "expectedRevision", "profileId", "hostGeneration", "snapshotRevision", "target", "generatedAt", "entries"],
  "properties": {
    "contract": { "const": "cordisx.channel-manager-log-page/v1" },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "channel-manager-common.v1.schema.json#/$defs/requestId" },
    "expectedRevision": { "$ref": "channel-manager-common.v1.schema.json#/$defs/revision" },
    "profileId": { "$ref": "channel-manager-common.v1.schema.json#/$defs/profileId" },
    "hostGeneration": { "$ref": "channel-manager-common.v1.schema.json#/$defs/hostGeneration" },
    "snapshotRevision": { "$ref": "channel-manager-common.v1.schema.json#/$defs/revision" },
    "target": { "$ref": "channel-manager-common.v1.schema.json#/$defs/logTarget" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "nextCursor": { "$ref": "channel-manager-common.v1.schema.json#/$defs/requestId" },
    "entries": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "occurredAt", "level", "event", "code", "connectionToken"],
      "properties": {
        "entryId": { "$ref": "channel-manager-common.v1.schema.json#/$defs/requestId" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "event": { "enum": ["connection.started", "connection.ready", "connection.retrying", "connection.stopped", "connection.rejected", "binding.created", "binding.archived", "binding.restored", "binding.unbound", "export.created"] },
        "code": { "$ref": "channel-manager-common.v1.schema.json#/$defs/resultCode" },
        "connectionToken": { "$ref": "channel-manager-common.v1.schema.json#/$defs/opaqueToken" },
        "bindingToken": { "$ref": "channel-manager-common.v1.schema.json#/$defs/opaqueToken" },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
