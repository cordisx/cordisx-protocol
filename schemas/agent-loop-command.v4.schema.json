{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-command.v4.schema.json",
  "title": "CordisX Agent Loop Command v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "commandId", "type"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-command.v4.schema.json" },
    "contract": { "const": "cordisx.agent-loop-command/v4" },
    "schemaVersion": { "const": 4 },
    "commandId": {
      "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle",
      "description": "Consumer-persisted operation id retained by the owning provider across bound-client disposal; non-identical reuse is invalid."
    },
    "type": { "enum": ["create-or-bind", "send", "approval-decision", "request-member-self-introduction", "cancel-member-self-introduction"] },
    "definition": { "$ref": "agent-loop-common.v4.schema.json#/$defs/definitionIdentity" },
    "definitions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "agent-definition.v1.schema.json" } },
    "target": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "const": "create" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["mode", "task"],
          "properties": { "mode": { "const": "bind" }, "task": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" } }
        }
      ]
    },
    "binding": { "$ref": "agent-loop-task-binding.v4.schema.json" },
    "content": { "$ref": "agent-loop-common.v4.schema.json#/$defs/content" },
    "turn": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" },
    "approvalId": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" },
    "decision": { "enum": ["approved", "denied", "cancelled"] },
    "participantId": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" },
    "memberId": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" },
    "runId": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "audience", "output"],
      "properties": {
        "kind": { "const": "member-self-introduction" },
        "audience": { "const": "room" },
        "output": { "const": "assistant-message" }
      }
    },
    "requestOperationId": { "$ref": "agent-loop-common.v4.schema.json#/$defs/opaqueHandle" }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "create-or-bind" } } },
      "then": {
        "required": ["definition", "definitions", "target"],
        "properties": { "definition": true, "definitions": true, "target": true, "binding": false, "content": false, "turn": false, "approvalId": false, "decision": false, "participantId": false, "memberId": false, "runId": false, "intent": false, "requestOperationId": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "send" } } },
      "then": {
        "required": ["binding", "content"],
        "properties": { "definition": false, "definitions": false, "target": false, "binding": true, "content": true, "turn": false, "approvalId": false, "decision": false, "participantId": false, "memberId": false, "runId": false, "intent": false, "requestOperationId": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "approval-decision" } } },
      "then": {
        "required": ["binding", "turn", "approvalId", "decision"],
        "properties": { "definition": false, "definitions": false, "target": false, "binding": true, "content": false, "turn": true, "approvalId": true, "decision": true, "participantId": false, "memberId": false, "runId": false, "intent": false, "requestOperationId": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "request-member-self-introduction" } } },
      "then": {
        "required": ["binding", "participantId", "memberId", "runId", "intent"],
        "properties": { "definition": false, "definitions": false, "target": false, "binding": true, "content": false, "turn": false, "approvalId": false, "decision": false, "participantId": true, "memberId": true, "runId": true, "intent": true, "requestOperationId": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "cancel-member-self-introduction" } } },
      "then": {
        "required": ["binding", "participantId", "memberId", "runId", "requestOperationId"],
        "properties": { "definition": false, "definitions": false, "target": false, "binding": true, "content": false, "turn": false, "approvalId": false, "decision": false, "participantId": true, "memberId": true, "runId": true, "intent": false, "requestOperationId": true }
      }
    }
  ]
}
