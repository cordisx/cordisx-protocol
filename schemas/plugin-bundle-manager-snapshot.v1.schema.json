{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-manager-snapshot.v1.schema.json",
  "title": "CordisX Plugin Bundle Manager Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profileId", "revision", "pluginRevision", "runtimeGeneration", "operationsAvailable", "bundles"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-manager-snapshot.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "revision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "pluginRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "runtimeGeneration": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/generation" },
    "operationsAvailable": { "type": "boolean" },
    "bundles": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "digest", "authors", "sourceLabel", "installedAt", "updatedAt", "status", "enabled", "readme", "availableOperations", "members", "permissions", "claims", "dependencies", "records"],
        "properties": {
          "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "minLength": 1, "maxLength": 512 },
          "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
          "digest": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/digest" },
          "authors": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
          "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
          "canonicalSource": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/canonicalPublicSource" },
          "iconHandle": { "type": "string", "pattern": "^bundle-icon:[A-Za-z0-9._:-]{1,128}$" },
          "installedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "status": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/bundleStatus" },
          "enabled": { "type": "boolean" },
          "readme": { "type": "string", "maxLength": 262144 },
          "availableOperations": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["update", "enable", "disable", "repair", "uninstall"] } },
          "members": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pluginId", "requestedVersion", "required", "enabledByDefault", "enabled", "state", "installedViaBundle", "bundleIds", "directClaim", "runtimeDependentIds"],
              "properties": {
                "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
                "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "requestedVersion": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
                "installedVersion": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
                "installedDigest": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/digest" },
                "required": { "type": "boolean" },
                "enabledByDefault": { "type": "boolean" },
                "enabled": { "type": "boolean" },
                "state": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/memberState" },
                "installedViaBundle": { "type": "boolean" },
                "bundleIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" } },
                "directClaim": { "type": "boolean" },
                "runtimeDependentIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" } },
                "conflict": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "message"],
                  "properties": {
                    "code": { "enum": ["version-mismatch", "digest-mismatch", "dependency-conflict"] },
                    "message": { "type": "string", "minLength": 1, "maxLength": 512 }
                  }
                }
              }
            }
          },
          "permissions": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["permissionId", "pluginId", "capability", "scopeLabel", "required", "bundlePolicy", "effectivePolicy", "effectiveSource", "affectedBundleIds"],
              "properties": {
                "permissionId": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/permissionId" },
                "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
                "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
                "scopeLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
                "required": { "type": "boolean" },
                "bundlePolicy": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/policy" },
                "pluginOverride": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/policy" },
                "effectivePolicy": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/policy" },
                "effectiveSource": { "enum": ["bundle", "shared-bundle-merge", "plugin-override", "safety-floor"] },
                "affectedBundleIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" } }
              }
            }
          },
          "claims": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pluginId", "kind", "claimantId"],
              "properties": {
                "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
                "kind": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/claimKind" },
                "claimantId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pluginId", "dependencyId", "version"],
              "properties": {
                "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
                "dependencyId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
                "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" }
              }
            }
          },
          "records": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recordId", "at", "kind", "outcome", "message", "pluginIds"],
              "properties": {
                "recordId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
                "at": { "type": "string", "format": "date-time" },
                "kind": { "$ref": "plugin-bundle-common.v1.schema.json#/$defs/operationKind" },
                "outcome": { "enum": ["planned", "applied", "conflict", "rejected", "rolled-back", "rollback-failed"] },
                "message": { "type": "string", "minLength": 1, "maxLength": 512 },
                "pluginIds": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "ui-common.v1.schema.json#/$defs/localId" } }
              }
            }
          }
        }
      }
    }
  }
}
