{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/usage-snapshot.v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "diagnostics",
        "status",
        "scopeId",
        "sourceId",
        "epoch",
        "revision",
        "eligibleTokens",
        "inputTokens",
        "outputTokens",
        "enabledAt",
        "observedThrough",
        "policyId",
        "coverage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "status": {
          "const": "ready"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligibleTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabledAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedThrough": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyId": {
          "const": "codex-local-input-output-v1"
        },
        "coverage": {
          "const": "partial"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "diagnostics",
        "status",
        "reason"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "permission-denied",
            "host-unavailable",
            "source-unavailable",
            "store-unavailable",
            "generation-retired"
          ]
        }
      }
    }
  ]
}
