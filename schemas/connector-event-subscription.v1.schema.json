{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-event-subscription.v1.schema.json",
  "title": "CordisX Connector Event Subscription v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "subscriptionId", "registration", "afterSequence", "snapshotSequence"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-event-subscription.v1.schema.json" },
    "contract": { "const": "cordisx.connector-event-subscription/v1" },
    "schemaVersion": { "const": 1 },
    "subscriptionId": { "$ref": "connector-common.v1.schema.json#/$defs/opaqueHandle" },
    "registration": { "$ref": "connector-common.v1.schema.json#/$defs/registration" },
    "afterSequence": { "type": "integer", "minimum": -1 },
    "snapshotSequence": { "type": "integer", "minimum": 0 }
  }
}
