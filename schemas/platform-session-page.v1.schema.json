{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/platform-session-page.v1.schema.json",
  "title": "CordisX Platform Session Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "query", "snapshotId", "sessions"],
  "properties": {
    "contract": { "const": "cordisx.platform-session-page/v1" },
    "schemaVersion": { "const": 1 },
    "query": { "$ref": "#/$defs/query" },
    "snapshotId": { "$ref": "platform-model.v1.schema.json#/$defs/opaqueId" },
    "nextCursor": { "$ref": "platform-model.v1.schema.json#/$defs/opaqueId" },
    "sessions": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "platform-session.v1.schema.json" }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "platform-model.v1.schema.json#/$defs/providerId" }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "searchTerm": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    }
  }
}
