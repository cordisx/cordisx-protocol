{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-subscription.v1.schema.json",
  "title": "CordisX Managed Service Subscription Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["subscriptionId", "binding", "afterSequence", "snapshotSequence"],
  "properties": {
    "subscriptionId": { "$ref": "managed-service-common.v1.schema.json#/$defs/opaqueId" },
    "binding": { "$ref": "managed-service-common.v1.schema.json#/$defs/binding" },
    "afterSequence": { "$ref": "managed-service-common.v1.schema.json#/$defs/sequence" },
    "snapshotSequence": { "$ref": "managed-service-common.v1.schema.json#/$defs/sequence" }
  }
}
