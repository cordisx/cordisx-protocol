{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-dom-bridge-request.v1.schema.json",
  "title": "CordisX Bound Host DOM Bridge Request v1",
  "oneOf": [
    { "$ref": "#/$defs/acquire" },
    { "$ref": "#/$defs/read" },
    { "$ref": "#/$defs/modify" },
    { "$ref": "#/$defs/release" }
  ],
  "$defs": {
    "baseProperties": {
      "type": "object",
      "properties": {
        "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-dom-bridge-request.v1.schema.json" },
        "contract": { "const": "cordisx.bound-host-dom/v1" },
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
      }
    },
    "acquire": {
      "oneOf": [{ "$ref": "#/$defs/acquireRead" }, { "$ref": "#/$defs/acquireModify" }]
    },
    "acquireRead": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "capability", "rootId", "operations"],
      "properties": {
        "$schema": { "$ref": "#/$defs/baseProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/baseProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/baseProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/baseProperties/properties/requestId" },
        "type": { "const": "acquire" }, "capability": { "const": "ui.host-dom.read" },
        "rootId": { "$ref": "host-dom-common.v1.schema.json#/$defs/rootId" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "host-dom-common.v1.schema.json#/$defs/readOperation" } }
      }
    },
    "acquireModify": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "capability", "rootId", "operations"],
      "properties": {
        "$schema": { "$ref": "#/$defs/baseProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/baseProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/baseProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/baseProperties/properties/requestId" },
        "type": { "const": "acquire" }, "capability": { "const": "ui.host-dom.modify" },
        "rootId": { "$ref": "host-dom-common.v1.schema.json#/$defs/rootId" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "host-dom-common.v1.schema.json#/$defs/modifyOperation" } }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation"],
      "properties": {
        "$schema": { "$ref": "#/$defs/baseProperties/properties/$schema" },
        "contract": { "$ref": "#/$defs/baseProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/baseProperties/properties/schemaVersion" },
        "requestId": { "$ref": "#/$defs/baseProperties/properties/requestId" },
        "type": { "const": "read" },
        "handle": { "$ref": "host-dom-common.v1.schema.json#/$defs/handle" },
        "operation": { "$ref": "host-dom-common.v1.schema.json#/$defs/readOperation" },
        "node": { "$ref": "host-dom-common.v1.schema.json#/$defs/nodeRef" },
        "attributes": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": { "$ref": "host-dom-common.v1.schema.json#/$defs/readableAttribute" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "read-attributes" } }, "required": ["operation"] },
          "then": { "required": ["attributes"], "properties": { "attributes": true } },
          "else": { "properties": { "attributes": false } }
        }
      ]
    },
    "modify": {
      "oneOf": [
        { "$ref": "#/$defs/setText" },
        { "$ref": "#/$defs/setAttribute" },
        { "$ref": "#/$defs/insertOwnedChild" },
        { "$ref": "#/$defs/removeOwnedChild" },
        { "$ref": "#/$defs/focus" }
      ]
    },
    "modifyProperties": {
      "type": "object",
      "properties": {
        "$schema": { "$ref": "#/$defs/baseProperties/properties/$schema" },
        "contract": { "$ref": "#/$defs/baseProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/baseProperties/properties/schemaVersion" },
        "requestId": { "$ref": "#/$defs/baseProperties/properties/requestId" },
        "type": { "const": "modify" },
        "handle": { "$ref": "host-dom-common.v1.schema.json#/$defs/handle" },
        "node": { "$ref": "host-dom-common.v1.schema.json#/$defs/nodeRef" }
      }
    },
    "setText": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation", "text"],
      "properties": {
        "$schema": { "$ref": "#/$defs/modifyProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/modifyProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/modifyProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/modifyProperties/properties/requestId" },
        "type": { "$ref": "#/$defs/modifyProperties/properties/type" }, "handle": { "$ref": "#/$defs/modifyProperties/properties/handle" },
        "node": { "$ref": "#/$defs/modifyProperties/properties/node" }, "operation": { "const": "set-text" },
        "text": { "type": "string", "maxLength": 16384 }
      }
    },
    "setAttribute": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation", "attribute", "value"],
      "properties": {
        "$schema": { "$ref": "#/$defs/modifyProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/modifyProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/modifyProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/modifyProperties/properties/requestId" },
        "type": { "$ref": "#/$defs/modifyProperties/properties/type" }, "handle": { "$ref": "#/$defs/modifyProperties/properties/handle" },
        "node": { "$ref": "#/$defs/modifyProperties/properties/node" }, "operation": { "const": "set-attribute" },
        "attribute": { "$ref": "host-dom-common.v1.schema.json#/$defs/mutableAttribute" },
        "value": { "$ref": "host-dom-common.v1.schema.json#/$defs/attributeValue" }
      }
    },
    "insertOwnedChild": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation", "child"],
      "properties": {
        "$schema": { "$ref": "#/$defs/modifyProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/modifyProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/modifyProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/modifyProperties/properties/requestId" },
        "type": { "$ref": "#/$defs/modifyProperties/properties/type" }, "handle": { "$ref": "#/$defs/modifyProperties/properties/handle" },
        "node": { "$ref": "#/$defs/modifyProperties/properties/node" }, "operation": { "const": "insert-owned-structured-child" },
        "child": { "$ref": "host-dom-common.v1.schema.json#/$defs/structuredChild" }
      }
    },
    "removeOwnedChild": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation", "childId"],
      "properties": {
        "$schema": { "$ref": "#/$defs/modifyProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/modifyProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/modifyProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/modifyProperties/properties/requestId" },
        "type": { "$ref": "#/$defs/modifyProperties/properties/type" }, "handle": { "$ref": "#/$defs/modifyProperties/properties/handle" },
        "node": { "$ref": "#/$defs/modifyProperties/properties/node" }, "operation": { "const": "remove-owned-child" },
        "childId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
      }
    },
    "focus": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle", "operation"],
      "properties": {
        "$schema": { "$ref": "#/$defs/modifyProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/modifyProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/modifyProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/modifyProperties/properties/requestId" },
        "type": { "$ref": "#/$defs/modifyProperties/properties/type" }, "handle": { "$ref": "#/$defs/modifyProperties/properties/handle" },
        "node": { "$ref": "#/$defs/modifyProperties/properties/node" }, "operation": { "const": "focus" }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "type", "handle"],
      "properties": {
        "$schema": { "$ref": "#/$defs/baseProperties/properties/$schema" }, "contract": { "$ref": "#/$defs/baseProperties/properties/contract" },
        "schemaVersion": { "$ref": "#/$defs/baseProperties/properties/schemaVersion" }, "requestId": { "$ref": "#/$defs/baseProperties/properties/requestId" },
        "type": { "const": "release" }, "handle": { "$ref": "host-dom-common.v1.schema.json#/$defs/handle" }
      }
    }
  }
}
