{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-connection-configuration.v1.schema.json",
  "title": "CordisX Channel Manager connection configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "profileId",
    "hostGeneration",
    "connectionToken",
    "revision",
    "selectors"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-manager-connection-configuration/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hostGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "connectionToken": {
      "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "direct",
          "group",
          "mentions",
          "replies"
        ]
      }
    }
  }
}
