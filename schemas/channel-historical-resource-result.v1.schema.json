{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-historical-resource-result.v1.schema.json",
  "title": "Channel historical resource result v1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["status", "messageId", "index", "type", "resource"],
      "properties": {
        "status": { "const": "ok" },
        "messageId": { "type": "string", "pattern": "^om_[A-Za-z0-9_]{1,200}$" },
        "index": { "type": "integer", "minimum": 0, "maximum": 15 },
        "type": { "enum": ["image", "file", "audio", "video"] },
        "resource": { "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["state", "expiresAt", "attachment"],
            "properties": {
              "state": { "const": "ready" },
              "expiresAt": { "type": "integer", "minimum": 0 },
              "attachment": {
                "type": "object", "additionalProperties": false,
                "required": ["type", "handle", "mediaType", "size"],
                "properties": {
                  "type": { "const": "attachment" },
                  "handle": { "type": "string", "minLength": 1, "maxLength": 512 },
                  "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "size": { "type": "integer", "minimum": 1, "maximum": 30000000 },
                  "name": { "type": "string", "minLength": 1, "maxLength": 255 }
                }
              }
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["state"],
            "properties": { "state": { "enum": ["expired", "not-prepared", "unavailable"] } }
          }
        ] },
        "chunk": {
          "type": "object", "additionalProperties": false,
          "required": ["offset", "base64", "nextOffset", "hasMore"],
          "properties": {
            "offset": { "type": "integer", "minimum": 0, "maximum": 29999999 },
            "base64": { "type": "string", "minLength": 4, "maxLength": 87384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
            "nextOffset": { "type": "integer", "minimum": 1, "maximum": 30000000 },
            "hasMore": { "type": "boolean" }
          }
        }
      },
      "if": { "properties": { "chunk": {} }, "required": ["chunk"] },
      "then": { "properties": { "resource": { "type": "object", "properties": { "state": { "const": "ready" } } } } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["status", "code"],
      "properties": {
        "status": { "enum": ["rejected", "unavailable"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  ]
}
