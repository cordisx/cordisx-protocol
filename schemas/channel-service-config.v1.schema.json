{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-service-config.v1.schema.json",
  "title": "CordisX Launcher-owned Channel Connection Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "connections"],
  "properties": {
    "contract": { "const": "cordisx.channel-service-config/v1" },
    "schemaVersion": { "const": 1 },
    "connections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "adapterKind": {
      "enum": [
        "simulator",
        "feishu",
        "lark",
        "wecom-intelligent-bot",
        "wecom-enterprise-app",
        "wecom-message-push",
        "wechat-service"
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["simulator", "websocket", "webhook", "outbound-webhook"] },
        "callbackAlias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["mode"],
            "properties": { "mode": { "const": "webhook" } }
          },
          "then": {
            "type": "object",
            "required": ["callbackAlias"],
            "properties": { "callbackAlias": true }
          },
          "else": { "type": "object", "properties": { "callbackAlias": false } }
        }
      ]
    },
    "secretRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^(?:keychain|host-secret):[A-Za-z0-9][A-Za-z0-9._:/-]{0,500}$"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "adapterKind", "enabled", "transport"],
      "properties": {
        "ref": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" },
        "adapterKind": { "$ref": "#/$defs/adapterKind" },
        "enabled": { "type": "boolean" },
        "transport": { "$ref": "#/$defs/transport" },
        "secretRef": { "$ref": "#/$defs/secretRef" }
      },
      "oneOf": [
        {
          "required": ["adapterKind", "transport"],
          "properties": {
            "adapterKind": { "const": "simulator" },
            "transport": { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "simulator" } } },
            "secretRef": false
          }
        },
        {
          "required": ["adapterKind", "transport", "secretRef"],
          "properties": {
            "adapterKind": { "enum": ["feishu", "lark", "wecom-intelligent-bot"] },
            "transport": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["websocket", "webhook"] } } }
          }
        },
        {
          "required": ["adapterKind", "transport", "secretRef"],
          "properties": {
            "adapterKind": { "enum": ["wecom-enterprise-app", "wechat-service"] },
            "transport": { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "webhook" } } }
          }
        },
        {
          "required": ["adapterKind", "transport", "secretRef"],
          "properties": {
            "adapterKind": { "const": "wecom-message-push" },
            "transport": { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "outbound-webhook" } } }
          }
        }
      ]
    }
  }
}
