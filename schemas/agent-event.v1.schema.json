{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-event.v1.schema.json",
  "title": "CordisX Agent Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "eventId", "sessionId", "seq", "time", "type", "provenance", "source", "data"],
  "properties": {
    "contract": { "const": "cordisx.agent-events/v1" },
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/$defs/opaqueId" },
    "sessionId": { "$ref": "#/$defs/opaqueId" },
    "turnId": { "$ref": "#/$defs/opaqueId" },
    "stepId": { "$ref": "#/$defs/opaqueId" },
    "itemId": { "$ref": "#/$defs/opaqueId" },
    "messageId": { "$ref": "#/$defs/opaqueId" },
    "toolCallId": { "$ref": "#/$defs/opaqueId" },
    "contextId": { "$ref": "#/$defs/opaqueId" },
    "seq": { "type": "integer", "minimum": 0 },
    "time": { "type": "integer", "minimum": 0 },
    "type": {
      "enum": [
        "session.lifecycle",
        "turn.lifecycle",
        "step.lifecycle",
        "item.lifecycle",
        "message.observed",
        "message.delivery",
        "content.chunk",
        "diagnostic"
      ]
    },
    "provenance": { "enum": ["observed", "cordisx", "inferred"] },
    "source": { "$ref": "#/$defs/source" },
    "causalParentId": { "$ref": "#/$defs/opaqueId" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "session.lifecycle" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/sessionLifecycle" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn.lifecycle" } } },
      "then": { "required": ["turnId"], "properties": { "turnId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/turnLifecycle" } } }
    },
    {
      "if": { "properties": { "type": { "const": "step.lifecycle" } } },
      "then": { "required": ["turnId", "stepId"], "properties": { "turnId": { "$ref": "#/$defs/opaqueId" }, "stepId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/stepLifecycle" } } }
    },
    {
      "if": { "properties": { "type": { "const": "item.lifecycle" } } },
      "then": { "required": ["turnId", "itemId"], "properties": { "turnId": { "$ref": "#/$defs/opaqueId" }, "itemId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/itemLifecycle" } } }
    },
    {
      "if": { "properties": { "type": { "const": "message.observed" } } },
      "then": { "required": ["messageId"], "properties": { "messageId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/observedMessage" } } }
    },
    {
      "if": { "properties": { "type": { "const": "message.delivery" } } },
      "then": { "required": ["messageId"], "properties": { "messageId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/messageDelivery" } } }
    },
    {
      "if": { "properties": { "type": { "const": "content.chunk" } } },
      "then": { "required": ["turnId", "itemId"], "properties": { "turnId": { "$ref": "#/$defs/opaqueId" }, "itemId": { "$ref": "#/$defs/opaqueId" }, "data": { "$ref": "#/$defs/contentChunk" } } }
    },
    {
      "if": { "properties": { "type": { "const": "diagnostic" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/diagnostic" } } }
    }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "pluginSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "id", "version", "generation"],
      "properties": {
        "kind": { "const": "plugin" },
        "source": { "type": "string", "format": "uri", "maxLength": 4096 },
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "version": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "generation": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "adapterId", "adapterVersion", "hostId"],
          "properties": {
            "kind": { "const": "adapter" },
            "adapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
            "hostId": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "component", "generation"],
          "properties": {
            "kind": { "const": "cordisx" },
            "component": { "type": "string", "minLength": 1, "maxLength": 128 },
            "generation": { "$ref": "#/$defs/opaqueId" }
          }
        },
        { "$ref": "#/$defs/pluginSource" }
      ]
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "type": "string", "maxLength": 1000000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref", "mediaType"],
          "properties": {
            "type": { "const": "reference" },
            "ref": { "$ref": "#/$defs/opaqueId" },
            "mediaType": { "type": "string", "minLength": 1, "maxLength": 256 },
            "summary": { "type": "string", "maxLength": 2000 }
          }
        }
      ]
    },
    "userMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "content", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "role": { "const": "user" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/contentBlock" }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "sessionLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["opened", "resumed", "forked", "compacted", "closed"] },
        "parentSessionId": { "$ref": "#/$defs/opaqueId" },
        "seedThroughEventId": { "$ref": "#/$defs/opaqueId" },
        "history": { "enum": ["visible", "hidden", "partial", "unknown"] }
      }
    },
    "turnLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["started", "completed", "failed", "cancelled"] },
        "status": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "stepLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["started", "completed", "failed", "cancelled"] },
        "status": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "itemLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "kind"],
      "properties": {
        "phase": { "enum": ["started", "updated", "completed", "failed", "cancelled"] },
        "kind": {
          "enum": ["user-message", "assistant-message", "reasoning", "plan", "tool-call", "tool-result", "command", "file-change", "compaction", "other"]
        },
        "status": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "observedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "$ref": "#/$defs/userMessage" } }
    },
    "messageDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "target", "wakeup"],
      "properties": {
        "stage": { "enum": ["requested", "permission", "queued", "claimed", "projected", "forwarded", "failed", "expired", "cancelled"] },
        "target": { "enum": ["next-turn", "next-step"] },
        "wakeup": { "type": "boolean" },
        "message": { "$ref": "#/$defs/userMessage" },
        "capability": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy": { "enum": ["ask", "deny", "allow"] },
        "decision": { "enum": ["allow", "deny", "timeout"] },
        "declarationFingerprint": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      }
    },
    "contentChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "index"],
      "properties": {
        "channel": { "enum": ["assistant", "reasoning", "plan", "command", "file-change", "tool", "other"] },
        "index": { "type": "integer", "minimum": 0 },
        "delta": { "type": "string", "maxLength": 1000000 },
        "ref": { "$ref": "#/$defs/opaqueId" },
        "final": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["delta"], "properties": { "delta": {}, "ref": false } },
        { "required": ["ref"], "properties": { "ref": {}, "delta": false } }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" },
        "status": { "enum": ["implemented", "verified", "experimental", "unavailable"] }
      }
    }
  }
}
