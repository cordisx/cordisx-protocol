{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-outbound-capabilities.v3.schema.json",
  "title": "CordisX channel-outbound-capabilities v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "target",
    "types",
    "maxMediaBytes",
    "richtext"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-outbound-capabilities/v3"
    },
    "schemaVersion": {
      "const": 3
    },
    "target": {
      "$ref": "channel-common.v1.schema.json#/$defs/threadRef"
    },
    "types": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 7,
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "file",
          "video",
          "richtext",
          "card"
        ]
      }
    },
    "maxMediaBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000000
    },
    "richtext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraphs",
        "mentions",
        "links",
        "preparedImages",
        "inlineCode",
        "inlineCodeMode",
        "codeLanguages"
      ],
      "properties": {
        "paragraphs": {
          "type": "boolean"
        },
        "mentions": {
          "type": "boolean"
        },
        "links": {
          "type": "boolean"
        },
        "preparedImages": {
          "type": "boolean"
        },
        "inlineCode": {
          "type": "boolean"
        },
        "inlineCodeMode": {
          "const": "standalone-paragraph"
        },
        "codeLanguages": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "enum": [
              "PYTHON",
              "C",
              "CPP",
              "GO",
              "JAVA",
              "KOTLIN",
              "SWIFT",
              "PHP",
              "RUBY",
              "RUST",
              "JAVASCRIPT",
              "TYPESCRIPT",
              "BASH",
              "SHELL",
              "SQL",
              "JSON",
              "XML",
              "YAML",
              "HTML",
              "THRIFT"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "richtext": {
            "properties": {
              "paragraphs": {
                "const": true
              }
            },
            "required": [
              "paragraphs"
            ],
            "type": "object"
          }
        },
        "required": [
          "richtext"
        ]
      },
      "then": {
        "properties": {
          "types": {
            "contains": {
              "const": "richtext"
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "richtext": {
            "properties": {
              "mentions": {
                "const": true
              }
            },
            "required": [
              "mentions"
            ],
            "type": "object"
          }
        },
        "required": [
          "richtext"
        ]
      },
      "then": {
        "properties": {
          "richtext": {
            "properties": {
              "paragraphs": {
                "const": true
              }
            },
            "type": "object"
          },
          "types": {
            "contains": {
              "const": "richtext"
            },
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "links": {
                "const": true
              }
            },
            "required": [
              "links"
            ]
          }
        },
        "required": [
          "richtext"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "paragraphs": {
                "const": true
              }
            }
          },
          "types": {
            "type": "array",
            "contains": {
              "const": "richtext"
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "preparedImages": {
                "const": true
              }
            },
            "required": [
              "preparedImages"
            ]
          }
        },
        "required": [
          "richtext"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "paragraphs": {
                "const": true
              }
            }
          },
          "types": {
            "type": "array",
            "contains": {
              "const": "richtext"
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "inlineCode": {
                "const": true
              }
            },
            "required": [
              "inlineCode"
            ]
          }
        },
        "required": [
          "richtext"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "richtext": {
            "type": "object",
            "properties": {
              "paragraphs": {
                "const": true
              }
            }
          },
          "types": {
            "type": "array",
            "contains": {
              "const": "richtext"
            }
          }
        }
      }
    }
  ]
}
