{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-common.v3.schema.json",
  "title": "CordisX Permission Common Definitions v3",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pluginId"],
      "properties": {
        "source": { "$ref": "extension-point-common.v1.schema.json#/$defs/canonicalSource" },
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
      }
    },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "capability": {
      "enum": [
        "models.read",
        "tasks.catalog.read",
        "tasks.content.read",
        "tasks.create",
        "tasks.control",
        "turns.submit",
        "turns.control",
        "agents.create",
        "agents.resume",
        "agents.get",
        "agents.message.submit",
        "agents.message.cancel",
        "agents.cancel",
        "agents.live.subscribe",
        "sessions.get",
        "sessions.read",
        "sessions.subscribe",
        "approvals.request",
        "approvals.answer",
        "channel.accounts.read",
        "channel.accounts.connect",
        "channel.events.receive",
        "channel.events.subscribe",
        "channel.messages.send",
        "channel.bindings.read",
        "channel.bindings.write",
        "channel.attachments.read",
        "ui.extension-points.render"
      ]
    },
    "extensionPointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/providers" },
        "cwdRoots": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/cwdRoots" },
        "sessions": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/sessions" },
        "sessionIds": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/sessionIds" },
        "channelAccounts": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/channelAccounts" },
        "channelTenants": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/channelTenants" },
        "channelConversations": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/channelConversations" },
        "channelUsers": { "$ref": "plugin-manifest.v4.schema.json#/$defs/scope/properties/channelUsers" },
        "extensionPoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/extensionPointId" }
        }
      }
    },
    "securityFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy": { "enum": ["ask", "allow-persistent", "deny-persistent"] },
    "decision": { "enum": ["allow-once", "allow-persistent", "deny-once", "deny-persistent"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "runtimeGeneration"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "runtimeGeneration": { "type": "string", "minLength": 1, "maxLength": 200 },
        "moduleGeneration": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
      }
    },
    "authorizationKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "identity", "capability", "scope", "securityFingerprint"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "identity": { "$ref": "#/$defs/identity" },
        "capability": { "$ref": "#/$defs/capability" },
        "scope": { "$ref": "#/$defs/scope" },
        "securityFingerprint": { "$ref": "#/$defs/securityFingerprint" }
      }
    },
    "certificationProjection": {
      "$ref": "marketplace-certified-permission-projection.v1.schema.json"
    }
  }
}
