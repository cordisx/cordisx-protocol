{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json",
  "title": "CordisX Structured UI Common Definitions v1",
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}(?::[a-z0-9][a-z0-9._-]{0,95})?$"
    },
    "iconToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[a-z][a-z0-9.-]{0,63}$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "namespace": { "$ref": "#/$defs/reference" },
        "key": { "$ref": "#/$defs/localId" },
        "params": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "fallback": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "jsonValue": {
      "anyOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "commandReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" },
        "arguments": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "routeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" },
        "params": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      }
    },
    "disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/localizedText" }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "exists"],
          "properties": {
            "key": { "$ref": "#/$defs/localId" },
            "exists": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "equals"],
          "properties": {
            "key": { "$ref": "#/$defs/localId" },
            "equals": { "$ref": "#/$defs/scalar" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "notEquals"],
          "properties": {
            "key": { "$ref": "#/$defs/localId" },
            "notEquals": { "$ref": "#/$defs/scalar" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    }
  }
}
