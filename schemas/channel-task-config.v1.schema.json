{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-task-config.v1.schema.json",
  "title": "Channel task configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaults",
    "scopes",
    "permissions"
  ],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "effort": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "settings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "adapterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "direct",
                "group"
              ]
            }
          },
          "userIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "userGroupIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "providerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "effort": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "adapterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "direct",
                "group"
              ]
            }
          },
          "userIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "userGroupIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "providerId",
                "model",
                "effort"
              ]
            }
          },
          "providerIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "providerId",
                "model"
              ],
              "properties": {
                "providerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
