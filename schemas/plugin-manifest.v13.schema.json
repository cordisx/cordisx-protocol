{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v13.schema.json",
  "title": "CordisX Runtime Plugin Manifest v13",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "capabilities", "services"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v13.schema.json"
    },
    "schemaVersion": { "const": 13 },
    "id": { "$ref": "plugin-manifest.v12.schema.json#/properties/id" },
    "name": { "$ref": "plugin-manifest.v12.schema.json#/properties/name" },
    "capabilities": {
      "type": "array",
      "maxItems": 37,
      "items": {
        "oneOf": [
          { "$ref": "plugin-manifest.v12.schema.json#/properties/capabilities/items" },
          { "$ref": "#/$defs/runtimeExactRequestCapability" }
        ]
      }
    },
    "services": { "$ref": "plugin-manifest.v12.schema.json#/properties/services" }
  },
  "$defs": {
    "runtimeExactRequestCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "scope"],
      "properties": {
        "name": {
          "enum": [
            "tasks.content.read",
            "tasks.create",
            "tasks.control",
            "turns.submit",
            "turns.control"
          ]
        },
        "required": { "const": false },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime"],
          "properties": { "runtime": { "const": "exact-request" } }
        }
      }
    }
  }
}
