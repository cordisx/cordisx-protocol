{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-binding.v4.schema.json",
  "title": "CordisX Host-generated Agent Conversation Shell Binding v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "bindingId", "shell", "ownerGeneration", "routeSelection"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-binding.v4.schema.json" },
    "contract": { "const": "cordisx.agent-conversation-shell-binding/v4" },
    "schemaVersion": { "const": 4 },
    "bindingId": { "$ref": "agent-conversation-shell-common.v4.schema.json#/$defs/opaqueId" },
    "shell": { "const": "agent-desktop" },
    "ownerGeneration": { "$ref": "agent-conversation-shell-common.v4.schema.json#/$defs/generation" },
    "routeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "const": "room-or-new" },
        "selectedRoomParam": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
      }
    }
  }
}
