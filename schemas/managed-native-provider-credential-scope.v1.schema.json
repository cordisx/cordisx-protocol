{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-native-provider-credential-scope.v1.schema.json",
  "title": "CordisX Managed Native Provider Credential Scope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "requestBinding"],
  "properties": {
    "revision": { "type": "string", "pattern": "^scope_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
    "requestBinding": { "const": "path-v1" }
  }
}
