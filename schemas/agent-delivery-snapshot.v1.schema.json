{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-delivery-snapshot.v1.schema.json",
  "title": "CordisX Agent Delivery Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schemaVersion", "deliveryId", "messageId", "sessionId",
    "target", "wakeup", "owner", "stage", "terminal", "cancellable",
    "valid", "stageEventId"
  ],
  "properties": {
    "contract": { "const": "cordisx.agent-delivery/v1" },
    "schemaVersion": { "const": 1 },
    "deliveryId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "messageId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "sessionId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "target": { "enum": ["next-turn", "next-step"] },
    "wakeup": { "type": "boolean" },
    "owner": { "$ref": "agent-event.v1.schema.json#/$defs/pluginSource" },
    "stage": { "enum": ["requested", "permission", "queued", "claimed", "projected", "forwarded", "failed", "expired", "cancelled"] },
    "terminal": { "type": "boolean" },
    "cancellable": { "type": "boolean" },
    "valid": { "type": "boolean" },
    "stageEventId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "turnId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "stepId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "contextId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "diagnostic": { "$ref": "agent-event.v1.schema.json#/$defs/diagnostic" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "enum": ["requested", "permission", "queued"] } } },
      "then": { "properties": { "terminal": { "const": false } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["claimed", "projected"] } } },
      "then": { "properties": { "terminal": { "const": false }, "cancellable": { "const": false } } }
    },
    {
      "if": { "properties": { "stage": { "enum": ["forwarded", "failed", "expired", "cancelled"] } } },
      "then": { "properties": { "terminal": { "const": true }, "cancellable": { "const": false } } }
    },
    {
      "if": { "properties": { "valid": { "const": false } } },
      "then": { "properties": { "cancellable": { "const": false } } }
    }
  ]
}
