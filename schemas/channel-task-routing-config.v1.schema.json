{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-task-routing-config.v1.schema.json",
  "title": "CordisX Channel Task Consumer Routing Configuration v1",
  "description": "Configuration owned by an optional message consumer. Channel connection services neither read nor require this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "subscriptions"],
  "properties": {
    "contract": { "const": "cordisx.channel-task-routing-config/v1" },
    "schemaVersion": { "const": 1 },
    "subscriptions": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/subscription" }
    }
  },
  "$defs": {
    "selector": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["useDefault"], "properties": { "useDefault": { "const": true } } },
        { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } } }
      ]
    },
    "idList": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": { "$ref": "channel-common.v1.schema.json#/$defs/opaqueId" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationKinds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["direct", "group", "broadcast"] } },
        "allowedUserIds": { "$ref": "#/$defs/idList" },
        "allowedConversationIds": { "$ref": "#/$defs/idList" },
        "groupTrigger": { "enum": ["deny", "mention", "reply", "command", "mention-or-command"] },
        "commandPrefixes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } }
      },
      "allOf": [{
        "if": { "required": ["groupTrigger"], "properties": { "groupTrigger": { "enum": ["command", "mention-or-command"] } } },
        "then": { "required": ["commandPrefixes"], "properties": { "commandPrefixes": true } }
      }]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "profile", "workspaceAlias"],
      "properties": {
        "provider": { "$ref": "#/$defs/selector" },
        "model": { "$ref": "#/$defs/selector" },
        "profile": { "$ref": "#/$defs/selector" },
        "workspaceAlias": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "connection", "enabled", "policy", "task", "notifications"],
      "properties": {
        "id": { "$ref": "channel-common.v1.schema.json#/$defs/opaqueId" },
        "connection": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" },
        "enabled": { "type": "boolean" },
        "policy": { "$ref": "#/$defs/policy" },
        "task": { "$ref": "#/$defs/task" },
        "notifications": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["completion", "failure", "approval-required", "approval-resolved", "approval-expired"] } }
      }
    }
  }
}
