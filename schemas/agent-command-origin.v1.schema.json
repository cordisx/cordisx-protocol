{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-command-origin.v1.schema.json",
  "title": "CordisX Host-generated Agent Command Origin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "originId", "binding", "generation", "executionId", "commandId", "scope", "room"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-command-origin.v1.schema.json" },
    "contract": { "const": "cordisx.agent-command-origin/v1" },
    "schemaVersion": { "const": 1 },
    "originId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "binding": { "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/bindingRef" },
    "generation": { "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/generation" },
    "executionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "commandId": { "$ref": "ui-common.v1.schema.json#/$defs/reference" },
    "scope": { "const": "composer-submit" },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "participantId", "memberId", "runId"],
      "properties": {
        "roomId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "participantId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "memberId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "runId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" }
      }
    }
  }
}
