{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-message-send.v3.schema.json",
  "title": "CordisX channel-message-send v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "target",
    "kind",
    "idempotencyKey",
    "content",
    "fallback"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-message-send/v3"
    },
    "schemaVersion": {
      "const": 3
    },
    "target": {
      "$ref": "channel-common.v1.schema.json#/$defs/threadRef"
    },
    "kind": {
      "enum": [
        "completion",
        "approval",
        "failure",
        "reply"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "handle"
          ],
          "properties": {
            "type": {
              "enum": [
                "image",
                "audio",
                "file",
                "video"
              ]
            },
            "handle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^media:[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "blocks"
          ],
          "properties": {
            "type": {
              "const": "richtext"
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "style"
                    ],
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "style": {
                        "enum": [
                          "plain",
                          "strong",
                          "emphasis",
                          "code"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "nodes"
                    ],
                    "properties": {
                      "type": {
                        "const": "paragraph"
                      },
                      "nodes": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 128,
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "type",
                                "text",
                                "style"
                              ],
                              "properties": {
                                "type": {
                                  "const": "text"
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 4096
                                },
                                "style": {
                                  "enum": [
                                    "plain",
                                    "strong",
                                    "emphasis"
                                  ]
                                }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "type",
                                "userId"
                              ],
                              "properties": {
                                "type": {
                                  "const": "mention"
                                },
                                "userId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256,
                                  "pattern": "^[A-Za-z0-9_-]+$",
                                  "not": {
                                    "pattern": "^(?:[Aa][Ll][Ll]|[Ee][Vv][Ee][Rr][Yy][Oo][Nn][Ee]|[Hh][Ee][Rr][Ee])$"
                                  }
                                }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "type",
                                "text",
                                "url"
                              ],
                              "properties": {
                                "type": {
                                  "const": "link"
                                },
                                "text": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 4096
                                },
                                "url": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "format": "uri",
                                  "pattern": "^https?://[^/@\\\\\\s\\u0000-\\u001f\\u007f]+(?:[/?#][^\\\\\\s\\u0000-\\u001f\\u007f]*)?$"
                                }
                              }
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "type",
                                "handle"
                              ],
                              "properties": {
                                "type": {
                                  "const": "image"
                                },
                                "handle": {
                                  "type": "string",
                                  "maxLength": 512,
                                  "pattern": "^media:[A-Za-z0-9_-]+$"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "inline-code"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "^[^\\r\\n\\u0000]+$",
                        "not": {
                          "pattern": "^ +$"
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "code"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "language": {
                        "enum": [
                          "PYTHON",
                          "C",
                          "CPP",
                          "GO",
                          "JAVA",
                          "KOTLIN",
                          "SWIFT",
                          "PHP",
                          "RUBY",
                          "RUST",
                          "JAVASCRIPT",
                          "TYPESCRIPT",
                          "BASH",
                          "SHELL",
                          "SQL",
                          "JSON",
                          "XML",
                          "YAML",
                          "HTML",
                          "THRIFT"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "body"
          ],
          "properties": {
            "type": {
              "const": "card"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        }
      ]
    },
    "fallback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "reject"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "text"
          ],
          "properties": {
            "mode": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        }
      ]
    }
  }
}
