{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-lifecycle-operation.v1.schema.json",
  "title": "CordisX Plugin Lifecycle Operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "requestId",
    "profileId",
    "expectedRevision",
    "runtimeGeneration",
    "operation"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-lifecycle-operation.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "expectedRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "runtimeGeneration": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/generation" },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceDirectory"],
          "properties": {
            "kind": { "const": "inspect-local" },
            "sourceDirectory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidateId", "authorizationDecision"],
          "properties": {
            "kind": { "enum": ["install", "update"] },
            "candidateId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
            "authorizationDecision": { "$ref": "permission-authorization-decision.v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId"],
          "properties": {
            "kind": { "const": "enable" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "authorizationDecision": { "$ref": "permission-authorization-decision.v1.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId"],
          "properties": {
            "kind": { "const": "reload" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId", "impactToken"],
          "properties": {
            "kind": { "enum": ["disable", "uninstall"] },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        }
      ]
    }
  }
}
