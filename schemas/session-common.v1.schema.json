{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-common.v1.schema.json",
  "title": "CordisX Session Common Types v1",
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "generation": { "type": "integer", "minimum": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "cursor": { "type": "integer", "minimum": -1 },
    "time": { "type": "integer", "minimum": 0 },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "pluginOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "generation"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identifier" },
        "generation": { "$ref": "#/$defs/generation" }
      }
    },
    "sessionHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "formatVersion", "createdAt", "isSeeded"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "formatVersion": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/time" },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "parentSessionId": { "$ref": "#/$defs/opaqueId" },
        "isSeeded": { "type": "boolean" },
        "origin": { "const": "subagent" },
        "delegationDepth": { "type": "integer", "minimum": 0 },
        "agentPreset": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "contentBlock": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "text"],
          "properties": { "type": { "const": "text" }, "text": { "type": "string", "maxLength": 1000000 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "text"],
          "properties": { "type": { "const": "reasoning" }, "text": { "type": "string", "maxLength": 1000000 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "ref", "mediaType"],
          "properties": {
            "type": { "const": "image" },
            "ref": { "$ref": "#/$defs/opaqueId" },
            "mediaType": { "type": "string", "pattern": "^image/[A-Za-z0-9.+-]+$", "maxLength": 128 },
            "alt": { "type": "string", "maxLength": 2000 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "id", "name", "arguments"],
          "properties": {
            "type": { "const": "tool-call" },
            "id": { "$ref": "#/$defs/opaqueId" },
            "name": { "$ref": "#/$defs/identifier" },
            "arguments": { "type": "string", "maxLength": 1000000 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "toolCallId", "content"],
          "properties": {
            "type": { "const": "tool-result" },
            "toolCallId": { "$ref": "#/$defs/opaqueId" },
            "content": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/contentBlock" } },
            "isError": { "type": "boolean" }
          }
        }
      ]
    },
    "content": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/contentBlock" } },
    "pluginCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "id"],
      "properties": {
        "namespace": { "$ref": "#/$defs/identifier" },
        "id": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "userMessageSource": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "user" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId", "generation"],
          "properties": {
            "kind": { "const": "plugin" },
            "pluginId": { "$ref": "#/$defs/identifier" },
            "generation": { "$ref": "#/$defs/generation" },
            "form": { "enum": ["instructions", "catalog", "snapshot", "notice", "relay", "recall"] },
            "summary": { "type": "string", "maxLength": 120 },
            "correlation": { "$ref": "#/$defs/pluginCorrelation" }
          }
        }
      ]
    },
    "userMessage": {
      "type": "object", "additionalProperties": false, "required": ["id", "role", "content", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "role": { "const": "user" },
        "content": { "$ref": "#/$defs/content" },
        "source": { "$ref": "#/$defs/userMessageSource" }
      }
    },
    "assistantMessage": {
      "type": "object", "additionalProperties": false, "required": ["id", "role", "content", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "role": { "const": "assistant" },
        "content": { "$ref": "#/$defs/content" },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["kind", "provider", "model"],
          "properties": {
            "kind": { "const": "model" },
            "provider": { "$ref": "#/$defs/identifier" },
            "model": { "$ref": "#/$defs/identifier" },
            "replayState": { "$ref": "#/$defs/jsonValue" }
          }
        }
      }
    },
    "toolResultMessage": {
      "type": "object", "additionalProperties": false, "required": ["id", "role", "content", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "role": { "const": "user" },
        "content": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/contentBlock" } },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["kind", "callId"],
          "properties": { "kind": { "const": "tool" }, "callId": { "$ref": "#/$defs/opaqueId" } }
        }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["message", "code"],
      "properties": {
        "message": { "type": "string", "maxLength": 10000 },
        "code": { "$ref": "#/$defs/identifier" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "providerRetryAfterMs": { "type": "integer", "minimum": 0 },
        "requestId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "tokenUsage": {
      "type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "cacheReadTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "finishReason": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["stop", "tool-calls", "max-tokens"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "failure"], "properties": { "kind": { "enum": ["aborted", "error"] }, "failure": { "$ref": "#/$defs/failure" } } }
      ]
    },
    "streamChunk": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "index", "blockType"], "properties": { "type": { "const": "block-start" }, "index": { "type": "integer", "minimum": 0 }, "blockType": { "enum": ["text", "reasoning", "image", "tool-call", "tool-result"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "index", "text"], "properties": { "type": { "enum": ["text-delta", "reasoning-delta"] }, "index": { "type": "integer", "minimum": 0 }, "text": { "type": "string", "maxLength": 1000000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "index", "id", "argumentsDelta"], "properties": { "type": { "const": "tool-call-delta" }, "index": { "type": "integer", "minimum": 0 }, "id": { "$ref": "#/$defs/opaqueId" }, "name": { "$ref": "#/$defs/identifier" }, "argumentsDelta": { "type": "string", "maxLength": 1000000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "index", "block"], "properties": { "type": { "const": "block-end" }, "index": { "type": "integer", "minimum": 0 }, "block": { "$ref": "#/$defs/contentBlock" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "usage"], "properties": { "type": { "const": "usage" }, "usage": { "$ref": "#/$defs/tokenUsage" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "reason"], "properties": { "type": { "const": "finish" }, "reason": { "$ref": "#/$defs/finishReason" }, "replayState": { "$ref": "#/$defs/jsonValue" } } }
      ]
    },
    "cancelCause": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["user", "parent", "disposed"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "hook" }, "reason": { "type": "string", "minLength": 1, "maxLength": 1000 } } }
      ]
    },
    "turnEndReason": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["completed", "blocked", "max-tokens", "interrupted"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "aborted" }, "reason": { "$ref": "#/$defs/cancelCause" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "error"], "properties": { "kind": { "const": "error" }, "error": { "$ref": "#/$defs/failure" } } }
      ]
    },
    "surfaceOp": {
      "oneOf": [
        { "const": "append" },
        { "type": "object", "additionalProperties": false, "required": ["op", "start", "end"], "properties": { "op": { "const": "replace" }, "start": { "$ref": "#/$defs/seq" }, "end": { "$ref": "#/$defs/seq" } } }
      ]
    },
    "approvalOutcome": { "enum": ["allowed-once", "rejected", "cancelled", "unavailable"] }
  }
}
