{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-config-subscription-page.v2.schema.json",
  "title": "CordisX Manager Content Config Subscription Page v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "subscription", "phase", "updates", "nextAfterSequence", "hasMore"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-config-subscription-page.v2.schema.json" },
    "contract": { "const": "cordisx.manager-content-config-subscription-page/v2" },
    "schemaVersion": { "const": 2 },
    "subscription": { "$ref": "manager-content-config-subscription-page.v1.schema.json#/properties/subscription" },
    "phase": { "enum": ["replay", "live"] },
    "updates": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "sequence", "body"], "properties": { "kind": { "const": "snapshot-replaced" }, "sequence": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/sequence" }, "body": { "$ref": "manager-content-projection.v4.schema.json#/$defs/pluginConfigFormProjection" } } },
          { "$ref": "manager-content-config-subscription-page.v1.schema.json#/properties/updates/items/oneOf/1" }
        ]
      }
    },
    "nextAfterSequence": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/sequence" },
    "hasMore": { "type": "boolean" }
  }
}
