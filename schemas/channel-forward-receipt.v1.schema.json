{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-forward-receipt.v1.schema.json",
  "title": "Channel forwarding receipt v1",
  "type": "object",
  "required": ["contract", "schemaVersion", "operationId", "operation", "state"],
  "properties": {
    "contract": { "const": "cordisx.channel-forward-receipt/v1" },
    "schemaVersion": { "const": 1 },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "operation": { "enum": ["forward", "merge-forward"] },
    "state": { "enum": ["sending", "sent", "partial", "failed", "unknown"] }
  },
  "oneOf": [
    { "properties": { "state": { "const": "sending" } } },
    {
      "required": ["externalMessageId", "invalidMessageIds"],
      "properties": {
        "state": { "enum": ["sent", "partial"] },
        "externalMessageId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "invalidMessageIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "sent" } } },
          "then": { "properties": { "invalidMessageIds": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "invalidMessageIds": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    {
      "required": ["code"],
      "properties": {
        "state": { "enum": ["failed", "unknown"] },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  ],
  "unevaluatedProperties": false
}
