{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-room-settings-result.v7.schema.json",
  "title": "CordisX Agent Conversation Shell Room Settings Update Result v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "type",
    "requestId",
    "binding",
    "generation",
    "roomId",
    "expectedSnapshotSequence",
    "status",
    "code"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-room-settings-result.v7.schema.json"
    },
    "contract": {
      "const": "cordisx.agent-conversation-shell-room-settings-result/v7"
    },
    "schemaVersion": {
      "const": 7
    },
    "type": {
      "const": "update-room-settings"
    },
    "requestId": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
    },
    "binding": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/bindingRef"
    },
    "generation": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/generation"
    },
    "roomId": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/opaqueId"
    },
    "expectedSnapshotSequence": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "applied",
        "conflict",
        "unavailable"
      ]
    },
    "code": {
      "enum": [
        "applied",
        "request-conflict",
        "owner-conflict",
        "generation-conflict",
        "room-conflict",
        "snapshot-conflict",
        "owner-unavailable",
        "settings-unavailable",
        "disposed"
      ]
    },
    "snapshotSequence": {
      "type": "integer",
      "minimum": 0
    },
    "currentSnapshotSequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "snapshotSequence"
        ],
        "properties": {
          "code": {
            "const": "applied"
          },
          "snapshotSequence": true,
          "currentSnapshotSequence": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "conflict"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "enum": [
              "request-conflict",
              "owner-conflict",
              "generation-conflict",
              "room-conflict",
              "snapshot-conflict"
            ]
          },
          "snapshotSequence": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "enum": [
              "owner-unavailable",
              "settings-unavailable",
              "disposed"
            ]
          },
          "snapshotSequence": false,
          "currentSnapshotSequence": false
        }
      }
    }
  ]
}
