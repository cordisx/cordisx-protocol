{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-capability-catalog.v3.schema.json",
  "title": "CordisX Host Capability Risk Catalog v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogVersion", "entries"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-capability-catalog.v3.schema.json" },
    "schemaVersion": { "const": 3 },
    "catalogVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability", "providerFamily", "resourceClass", "certifiedImplicitApproval", "sensitivity",
          "recommendedPolicy", "persistentAllow", "persistentDeny", "maximumScope", "scopeUpgrade",
          "installPrompt", "runtimePrompt", "presentation"
        ],
        "properties": {
          "capability": { "$ref": "permission-common.v4.schema.json#/$defs/capability" },
          "providerFamily": { "enum": ["platform", "agent", "channel", "ui"] },
          "resourceClass": { "enum": ["non-dom", "dom-rendering", "host-dom"] },
          "certifiedImplicitApproval": { "type": "boolean" },
          "sensitivity": { "enum": ["low", "general", "sensitive", "high-risk"] },
          "recommendedPolicy": { "$ref": "permission-common.v4.schema.json#/$defs/policy" },
          "persistentAllow": { "type": "boolean" },
          "persistentDeny": { "type": "boolean" },
          "maximumScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowedDimensions", "unscopedAllowed"],
            "properties": {
              "allowedDimensions": {
                "type": "array",
                "maxItems": 11,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "providers", "cwdRoots", "sessions", "sessionIds", "channelAccounts", "channelTenants",
                    "channelConversations", "channelUsers", "extensionPoints", "rootIds", "operations"
                  ]
                }
              },
              "unscopedAllowed": { "type": "boolean" }
            }
          },
          "scopeUpgrade": { "enum": ["any-change", "strict-expansion"] },
          "installPrompt": { "enum": ["batch-eligible", "explicit"] },
          "runtimePrompt": { "enum": ["first-use", "dynamic-scope", "always"] },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "risk", "limitation"],
            "properties": {
              "name": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "description": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "risk": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "limitation": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "certifiedImplicitApproval": { "const": true } }, "required": ["certifiedImplicitApproval"] },
            "then": {
              "properties": {
                "capability": { "enum": ["ui.extension-points.render", "ui.host-dom.read", "ui.host-dom.modify"] },
                "providerFamily": { "const": "ui" },
                "resourceClass": { "enum": ["dom-rendering", "host-dom"] }
              }
            }
          },
          {
            "if": { "properties": { "resourceClass": { "const": "non-dom" } }, "required": ["resourceClass"] },
            "then": { "properties": { "certifiedImplicitApproval": { "const": false } } }
          },
          {
            "if": { "properties": { "resourceClass": { "const": "host-dom" } }, "required": ["resourceClass"] },
            "then": {
              "properties": {
                "capability": { "enum": ["ui.host-dom.read", "ui.host-dom.modify"] },
                "providerFamily": { "const": "ui" },
                "certifiedImplicitApproval": { "const": true },
                "maximumScope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["allowedDimensions", "unscopedAllowed"],
                  "properties": {
                    "allowedDimensions": { "const": ["rootIds", "operations"] },
                    "unscopedAllowed": { "const": false }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "capability": { "const": "ui.extension-points.render" } }, "required": ["capability"] },
            "then": {
              "properties": {
                "providerFamily": { "const": "ui" },
                "resourceClass": { "const": "dom-rendering" },
                "certifiedImplicitApproval": { "const": true },
                "sensitivity": { "const": "general" },
                "recommendedPolicy": { "const": "ask" },
                "persistentAllow": { "const": true },
                "persistentDeny": { "const": true },
                "maximumScope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["allowedDimensions", "unscopedAllowed"],
                  "properties": {
                    "allowedDimensions": { "const": ["extensionPoints"] },
                    "unscopedAllowed": { "const": false }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "capability": { "enum": ["ui.host-dom.read", "ui.host-dom.modify"] } }, "required": ["capability"] },
            "then": { "properties": { "resourceClass": { "const": "host-dom" } } },
            "else": {
              "if": { "properties": { "capability": { "not": { "const": "ui.extension-points.render" } } }, "required": ["capability"] },
              "then": {
                "properties": {
                  "resourceClass": { "const": "non-dom" },
                  "certifiedImplicitApproval": { "const": false }
                }
              }
            }
          },
          {
            "if": { "properties": { "capability": { "const": "ui.host-dom.read" } }, "required": ["capability"] },
            "then": {
              "properties": {
                "sensitivity": { "const": "sensitive" },
                "recommendedPolicy": { "const": "ask" },
                "persistentAllow": { "const": true },
                "persistentDeny": { "const": true },
                "scopeUpgrade": { "const": "strict-expansion" },
                "installPrompt": { "const": "explicit" },
                "runtimePrompt": { "const": "dynamic-scope" }
              }
            }
          },
          {
            "if": { "properties": { "capability": { "const": "ui.host-dom.modify" } }, "required": ["capability"] },
            "then": {
              "properties": {
                "sensitivity": { "const": "high-risk" },
                "recommendedPolicy": { "const": "ask" },
                "persistentAllow": { "const": false },
                "persistentDeny": { "const": true },
                "scopeUpgrade": { "const": "strict-expansion" },
                "installPrompt": { "const": "explicit" },
                "runtimePrompt": { "const": "always" }
              }
            }
          }
        ]
      }
    }
  }
}
