{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-document-readback.v1.schema.json",
  "title": "CordisX package document readback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "pluginId",
    "id",
    "title",
    "content"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.plugin-document-readback/v1"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "content": {
      "type": "string",
      "maxLength": 262144
    }
  }
}
