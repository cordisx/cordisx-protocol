{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-config-result.v1.schema.json",
  "title": "CordisX Manager Content Config Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "commandId", "binding", "expectedRevision", "operation", "status", "code", "revision"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-config-result.v1.schema.json" },
    "contract": { "const": "cordisx.manager-content-config-result/v1" },
    "schemaVersion": { "const": 1 },
    "commandId": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/opaqueId" },
    "binding": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/binding" },
    "expectedRevision": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/revision" },
    "operation": { "enum": ["draft.validate", "draft.save", "defaults.materialize"] },
    "status": { "enum": ["validated", "applied", "staged", "preserved", "conflict", "rejected", "unavailable"] },
    "code": { "enum": ["valid", "saved", "defaults-materialized", "values-present", "already-materialized", "revision-conflict", "command-conflict", "validation-failed", "secret-path", "default-not-declared", "default-schema-mismatch", "not-writable", "owner-unavailable", "stale-generation", "binding-replaced", "disposed", "persistence-failed", "plugin-restart-failed", "service-restart-failed", "rollback-failed"] },
    "revision": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/revision" },
    "currentRevision": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/revision" },
    "applies": { "$ref": "plugin-config-common.v2.schema.json#/$defs/applies" },
    "resultingGeneration": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/generation" },
    "validation": { "$ref": "manager-content-config-common.v1.schema.json#/$defs/validation" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "validated" } }, "required": ["status"] }, "then": { "required": ["validation"], "properties": { "code": { "const": "valid" }, "validation": { "type": "object", "properties": { "state": { "const": "valid" } } }, "currentRevision": false, "applies": false, "resultingGeneration": false } } },
    { "if": { "properties": { "status": { "const": "applied" } }, "required": ["status"] }, "then": { "required": ["applies", "resultingGeneration"], "properties": { "code": { "enum": ["saved", "defaults-materialized"] }, "applies": { "enum": ["live", "plugin-restart", "service-restart"] }, "resultingGeneration": true, "currentRevision": false, "validation": false } } },
    { "if": { "properties": { "status": { "const": "staged" } }, "required": ["status"] }, "then": { "required": ["applies"], "properties": { "code": { "enum": ["saved", "defaults-materialized"] }, "applies": { "const": "app-restart" }, "currentRevision": false, "resultingGeneration": false, "validation": false } } },
    { "if": { "properties": { "status": { "const": "preserved" } }, "required": ["status"] }, "then": { "properties": { "code": { "enum": ["values-present", "already-materialized"] }, "currentRevision": false, "applies": false, "resultingGeneration": false, "validation": false } } },
    { "if": { "properties": { "status": { "const": "conflict" } }, "required": ["status"] }, "then": { "required": ["currentRevision"], "properties": { "code": { "enum": ["revision-conflict", "command-conflict"] }, "applies": false, "resultingGeneration": false, "validation": false } } },
    { "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] }, "then": { "properties": { "code": { "enum": ["validation-failed", "secret-path", "default-not-declared", "default-schema-mismatch"] }, "currentRevision": false, "applies": false, "resultingGeneration": false } } },
    { "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] }, "then": { "properties": { "code": { "enum": ["not-writable", "owner-unavailable", "stale-generation", "binding-replaced", "disposed", "persistence-failed", "plugin-restart-failed", "service-restart-failed", "rollback-failed"] }, "currentRevision": false, "applies": false, "resultingGeneration": false, "validation": false } } },
    { "if": { "properties": { "status": { "const": "rejected" }, "code": { "const": "validation-failed" } }, "required": ["status", "code"] }, "then": { "required": ["validation"], "properties": { "validation": { "type": "object", "properties": { "state": { "const": "invalid" } } } } } },
    { "if": { "properties": { "status": { "const": "rejected" }, "code": { "enum": ["secret-path", "default-not-declared", "default-schema-mismatch"] } }, "required": ["status", "code"] }, "then": { "properties": { "validation": false } } }
  ]
}
