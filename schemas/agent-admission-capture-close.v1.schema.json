    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-admission-capture-close.v1.schema.json" },
    "contract": { "const": "cordisx.agent-admission-capture-close/v1" },
    "schemaVersion": { "const": 1 },
    "receiptId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "status": { "const": "closed" },
    "code": { "enum": ["command-complete", "command-replaced", "agent-replaced", "plugin-generation-replaced", "connection-replaced", "disposed"] }
  }
}
