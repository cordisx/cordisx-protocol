{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-admission-capture-close.v1.schema.json",
  "title": "CordisX Agent Admission Capture Close v1",
  "type": "object",
