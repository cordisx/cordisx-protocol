{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-package.v3.schema.json",
  "title": "CordisX Explicit Local Plugin Package Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "version",
    "entry",
    "distribution",
    "compatibility",
    "dependencies",
    "runtimeManifest"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-package.v3.schema.json"
    },
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "version": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/semanticVersion" },
    "entry": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:mjs|js|ts)$"
    },
    "readme": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:md|markdown)$"
    },
    "canonicalSource": {
      "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/canonicalPublicSource"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "signature"],
      "properties": {
        "mode": { "const": "explicit-local-v1" },
        "signature": { "const": "unsupported" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeAbi", "protocolSchemas"],
      "properties": {
        "runtimeAbi": { "const": 1 },
        "protocolSchemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/dependency" }
    },
    "runtimeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "digest"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.json$"
        },
        "schema": {
          "enum": [
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v1.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v2.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v3.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v4.schema.json"
          ]
        },
        "digest": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/digest" }
      }
    }
  }
}
