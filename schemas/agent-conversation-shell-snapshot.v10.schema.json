{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v10.schema.json",
  "title": "CordisX Agent Conversation Shell Snapshot v10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "binding",
    "generation",
    "snapshotSequence",
    "selection",
    "items",
    "composer",
    "headerActions"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v10.schema.json"
    },
    "contract": {
      "const": "cordisx.agent-conversation-shell-snapshot/v10"
    },
    "schemaVersion": {
      "const": 10
    },
    "binding": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/bindingRef"
    },
    "generation": {
      "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/generation"
    },
    "snapshotSequence": {
      "type": "integer",
      "minimum": 0
    },
    "selection": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v7.schema.json#/$defs/selection"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "anyOf": [
          {
            "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v7.schema.json#/$defs/item"
          },
          {
            "$ref": "agent-conversation-plugin-command-message.v1.schema.json"
          }
        ]
      }
    },
    "composer": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-snapshot.v7.schema.json#/$defs/composer"
    },
    "headerActions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "agent-conversation-shell-common.v7.schema.json#/$defs/action"
      }
    }
  }
}
