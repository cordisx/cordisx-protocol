{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/brand-icon.v1.schema.json",
  "title": "CordisX brand icon v1",
  "$ref": "#/$defs/brandIcon",
  "$defs": {
    "brandIcon": {
      "oneOf": [
        {
          "$ref": "ui-common.v1.schema.json#/$defs/hostIconToken"
        },
        {
          "$ref": "#/$defs/rasterBrandIcon"
        }
      ]
    },
    "rasterBrandIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "image"
      ],
      "properties": {
        "kind": {
          "const": "raster-image"
        },
        "image": {
          "$ref": "raster-image-snapshot.v1.schema.json"
        }
      }
    }
  }
}
