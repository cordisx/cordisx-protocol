{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-session-detail-reference-result.v1.schema.json",
  "title": "CordisX current Session detail reference result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sessionId", "target"],
      "properties": {
        "status": { "const": "accepted" },
        "sessionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "target": { "$ref": "agent-detail-reference.v1.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code"],
      "properties": { "status": { "const": "denied" }, "code": { "const": "permission-denied" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "code"],
      "properties": {
        "status": { "const": "unavailable" },
        "code": { "enum": ["session-unavailable", "detail-unavailable", "generation-replaced", "connection-replaced", "host-unavailable", "unsupported"] }
      }
    }
  ]
}
