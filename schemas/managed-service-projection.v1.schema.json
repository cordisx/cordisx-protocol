{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-projection.v1.schema.json",
  "title": "CordisX Renderer-safe Managed Service Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "binding",
    "sequence",
    "observedAt",
    "identity",
    "displayName",
    "serviceKind",
    "readiness",
    "auth",
    "health",
    "diagnostics",
    "capabilities",
    "userAction"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-projection.v1.schema.json"
    },
    "contract": { "const": "cordisx.managed-service-projection/v1" },
    "schemaVersion": { "const": 1 },
    "binding": { "$ref": "managed-service-common.v1.schema.json#/$defs/binding" },
    "sequence": { "$ref": "managed-service-common.v1.schema.json#/$defs/sequence" },
    "observedAt": { "type": "string", "format": "date-time" },
    "identity": { "$ref": "managed-service-common.v1.schema.json#/$defs/identity" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "serviceKind": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "readiness": { "$ref": "managed-service-common.v1.schema.json#/$defs/readiness" },
    "revision": { "$ref": "managed-service-common.v1.schema.json#/$defs/revision" },
    "serviceGeneration": { "$ref": "managed-service-common.v1.schema.json#/$defs/generation" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accountHint"],
      "properties": {
        "state": { "$ref": "managed-service-common.v1.schema.json#/$defs/authState" },
        "authenticatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "accountHint": { "type": "string", "maxLength": 200 },
        "providerLabel": { "type": "string", "maxLength": 120 }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "$ref": "managed-service-common.v1.schema.json#/$defs/healthLevel" },
        "since": { "type": "string", "format": "date-time" }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "managed-service-common.v1.schema.json#/$defs/diagnostic" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicitLogin", "logout", "readCatalog"],
      "properties": {
        "explicitLogin": { "type": "boolean" },
        "logout": { "type": "boolean" },
        "readCatalog": { "type": "boolean" }
      }
    },
    "userAction": { "$ref": "managed-service-common.v1.schema.json#/$defs/loginAction" }
  }
}
