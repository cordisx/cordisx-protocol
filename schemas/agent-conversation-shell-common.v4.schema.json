{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-conversation-shell-common.v4.schema.json",
  "title": "CordisX Agent Conversation Shell Common v4",
  "$defs": {
    "opaqueId": { "$ref": "agent-conversation-shell-common.v2.schema.json#/$defs/opaqueId" },
    "generation": { "$ref": "agent-conversation-shell-common.v2.schema.json#/$defs/generation" },
    "displayText": { "$ref": "agent-conversation-shell-common.v2.schema.json#/$defs/displayText" },
    "bindingRef": { "$ref": "agent-conversation-shell-common.v2.schema.json#/$defs/bindingRef" },
    "action": { "$ref": "agent-conversation-shell-common.v2.schema.json#/$defs/action" },
    "sessionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "messageId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "sessionSeq": { "$ref": "session-common.v1.schema.json#/$defs/seq" },
    "agentGeneration": { "$ref": "session-common.v1.schema.json#/$defs/generation" },
    "agentDetailReference": { "$ref": "agents-common.v1.schema.json#/$defs/hostDetailRef" },
    "sessionEventSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sessionId", "eventSeq"],
      "properties": {
        "kind": { "const": "session-event" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "eventSeq": { "$ref": "#/$defs/sessionSeq" }
      }
    },
    "chatroomAcknowledgementSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "chatroom-acknowledgement" } }
    },
    "messageSource": {
      "oneOf": [
        { "$ref": "#/$defs/sessionEventSource" },
        { "$ref": "#/$defs/chatroomAcknowledgementSource" }
      ]
    },
    "roomName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "roomDescriptionPatch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "empty" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "text"],
          "properties": {
            "state": { "const": "present" },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F]+$"
            }
          }
        }
      ]
    },
    "roomCollectionParticipantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantId", "avatar"],
      "properties": {
        "participantId": { "$ref": "#/$defs/opaqueId" },
        "avatar": { "$ref": "agent-avatar.v1.schema.json" }
      }
    },
    "roomCollectionLeadingVisual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "icon"],
          "properties": {
            "kind": { "const": "semantic-icon" },
            "icon": { "$ref": "ui-common.v1.schema.json#/$defs/hostIconToken" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "roomId", "participants"],
          "properties": {
            "kind": { "const": "room-composite-avatar" },
            "roomId": { "$ref": "#/$defs/opaqueId" },
            "participants": {
              "type": "array",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/roomCollectionParticipantRef" }
            }
          }
        }
      ]
    }
  }
}
