{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-navigation.v6.schema.json",
  "title": "CordisX Manager Content Navigation Declaration v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "route",
    "header"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/manager-content-navigation.v6.schema.json"
    },
    "schemaVersion": {
      "const": 6
    },
    "id": {
      "$ref": "ui-common.v1.schema.json#/$defs/localId"
    },
    "route": {
      "$ref": "manager-content-navigation.v1.schema.json#/$defs/sameOwnerRouteReference"
    },
    "parentRoute": {
      "$ref": "manager-content-navigation.v1.schema.json#/$defs/sameOwnerRouteReference"
    },
    "header": {
      "$ref": "manager-content-navigation.v1.schema.json#/$defs/headerDescription"
    },
    "subject": {
      "$ref": "manager-content-navigation.v3.schema.json#/$defs/subject"
    },
    "recordSummary": {
      "$ref": "#/$defs/recordSummary"
    },
    "tabs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "manager-content-navigation.v3.schema.json#/$defs/tabDescription"
      }
    },
    "body": {
      "$ref": "manager-content-navigation.v4.schema.json#/properties/body"
    }
  },
  "$defs": {
    "displayText": {
      "$ref": "manager-content-navigation.v3.schema.json#/$defs/displayText"
    },
    "leadingVisual": {
      "oneOf": [
        {
          "$ref": "manager-content-navigation.v3.schema.json#/$defs/leadingVisual"
        },
        {
          "$ref": "manager-collection-common.v2.schema.json#/$defs/identityVisual"
        }
      ]
    },
    "summaryStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "icon",
        "tone"
      ],
      "properties": {
        "id": {
          "$ref": "ui-common.v1.schema.json#/$defs/localId"
        },
        "label": {
          "$ref": "#/$defs/displayText"
        },
        "icon": {
          "$ref": "brand-icon.v1.schema.json"
        },
        "tone": {
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ]
        }
      }
    },
    "recordSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leadingVisual",
        "title"
      ],
      "properties": {
        "leadingVisual": {
          "$ref": "#/$defs/leadingVisual"
        },
        "title": {
          "$ref": "#/$defs/displayText"
        },
        "description": {
          "$ref": "#/$defs/displayText"
        },
        "statuses": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/summaryStatus"
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/summaryMetric"
          }
        }
      }
    },
    "summaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "icon",
        "tone",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "ui-common.v1.schema.json#/$defs/localId"
        },
        "label": {
          "$ref": "#/$defs/displayText"
        },
        "icon": {
          "$ref": "brand-icon.v1.schema.json"
        },
        "tone": {
          "enum": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
