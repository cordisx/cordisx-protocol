{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/approval-request-routing-result.v1.schema.json",
  "title": "CordisX Pre-persistence Approval Request Routing Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "routingId", "registration", "status", "code", "requester", "authority"],
      "properties": {
        "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/approval-request-routing-result.v1.schema.json" },
        "contract": { "const": "cordisx.approval-request-routing-result/v1" },
        "schemaVersion": { "const": 1 },
        "routingId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "registration": { "$ref": "approval-request-routing-registration.v1.schema.json" },
        "status": { "const": "accepted" },
        "code": { "const": "routed" },
        "requester": { "$ref": "approval-common.v2.schema.json#/$defs/agentBinding" },
        "authority": { "$ref": "approval-common.v2.schema.json#/$defs/agentBinding" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "routingId", "registration", "status", "code"],
      "properties": {
        "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/approval-request-routing-result.v1.schema.json" },
        "contract": { "const": "cordisx.approval-request-routing-result/v1" },
        "schemaVersion": { "const": 1 },
        "routingId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
        "registration": { "$ref": "approval-request-routing-registration.v1.schema.json" },
        "status": { "const": "unavailable" },
        "code": { "enum": ["mapping-unavailable", "authority-unavailable"] }
      }
    }
  ]
}
