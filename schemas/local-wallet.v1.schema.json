{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordisx.dev/schemas/local-wallet.v1.schema.json",
  "title": "Host-profile local wallet signed payload v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "origin",
        "sourceId",
        "instanceId",
        "audience",
        "nonce",
        "expiresAt"
      ],
      "properties": {
        "contract": {
          "const": "cordisx.local-wallet-challenge/v1"
        },
        "origin": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "audience": {
          "enum": [
            "local-wallet-enrollment",
            "local-wallet",
            "local-work-income"
          ]
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
