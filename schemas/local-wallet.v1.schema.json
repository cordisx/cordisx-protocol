  "$defs": {
    "workSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "scopeId",
        "sourceId",
        "epoch",
        "revision",
        "policyId",
        "eligibleTokens",
        "inputTokens",
        "outputTokens",
        "enabledAt",
        "observedThrough",
        "coverage",
        "diagnostics",
        "classification"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "status": {
          "const": "ready"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policyId": {
          "const": "codex-local-work-input-output-v2"
        },
        "eligibleTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabledAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedThrough": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": {
          "const": "partial"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "hostGameTasks",
            "forksAndSubagents",
            "unknownSources"
          ],
          "properties": {
            "version": {
              "const": "host-game-cwd-v1"
            },
            "hostGameTasks": {
              "const": "excluded"
            },
            "forksAndSubagents": {
              "const": "excluded"
            },
            "unknownSources": {
              "const": "excluded"
            }
          }
        }
