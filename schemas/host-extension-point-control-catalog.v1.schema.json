{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-extension-point-control-catalog.v1.schema.json",
  "title": "CordisX Host Extension Point Control Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "points"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-extension-point-control-catalog.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "points": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pointPolicy" }
    }
  },
  "$defs": {
    "modePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stacking", "coexistsWith", "defaultAuthorization"],
      "properties": {
        "id": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/mode" },
        "stacking": { "enum": ["ordered", "exclusive"] },
        "exclusiveGroup": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "coexistsWith": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/mode" }
        },
        "defaultAuthorization": { "enum": ["allow", "deny"] }
      },
      "allOf": [
        {
          "if": { "properties": { "stacking": { "const": "exclusive" } }, "required": ["stacking"] },
          "then": { "required": ["exclusiveGroup"], "properties": { "exclusiveGroup": true } }
        },
        {
          "if": { "properties": { "stacking": { "const": "ordered" } }, "required": ["stacking"] },
          "then": { "properties": { "exclusiveGroup": false } }
        }
      ]
    },
    "exclusiveGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modes", "cardinality", "selection", "nativeFallback"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/mode" }
        },
        "cardinality": { "const": "one" },
        "selection": { "enum": ["user", "host-priority"] },
        "nativeFallback": { "type": "boolean" }
      }
    },
    "safeProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "visibility", "mutable"],
      "properties": {
        "id": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" },
        "schema": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/safeValueSchema" },
        "visibility": { "const": "renderer-safe" },
        "mutable": { "const": false }
      }
    },
    "safeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dispatch", "arguments"],
      "properties": {
        "id": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" },
        "dispatch": { "const": "host-brokered" },
        "arguments": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/argumentDescriptor" }
        }
      }
    },
    "safeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "delivery", "payload"],
      "properties": {
        "id": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" },
        "delivery": { "const": "host-projected" },
        "payload": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/argumentDescriptor" }
        }
      }
    },
    "ownershipPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "suppressesDescendantsWhenModes"],
      "properties": {
        "scope": { "enum": ["point", "subtree"] },
        "suppressesDescendantsWhenModes": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/mode" }
        }
      }
    },
    "pointPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modes", "exclusiveGroups", "safeProperties", "safeCommands", "safeEvents", "ownership"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "parentPointId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/modePolicy" }
        },
        "exclusiveGroups": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/exclusiveGroup" }
        },
        "safeProperties": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/safeProperty" }
        },
        "safeCommands": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/safeCommand" }
        },
        "safeEvents": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/safeEvent" }
        },
        "ownership": { "$ref": "#/$defs/ownershipPolicy" }
      }
    }
  }
}
