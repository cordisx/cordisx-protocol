{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/page.v4.schema.json",
  "title": "CordisX Page Metadata v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "description"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/page.v4.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "id": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
    },
    "title": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
    },
    "description": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
    },
    "icon": {
      "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/iconToken"
    },
    "chrome": {
      "enum": [
        "standard",
        "body-only"
      ],
      "default": "standard"
    },
    "contentInset": {
      "enum": [
        "standard",
        "none"
      ],
      "default": "standard"
    },
    "breadcrumbs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
      }
    },
    "tabs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
          },
          "label": {
            "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
          },
          "icon": {
            "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/iconToken"
          }
        }
      }
    },
    "headerActions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/headerAction"
      },
      "contains": {
        "type": "object",
        "required": [
          "presentation"
        ],
        "properties": {
          "presentation": {
            "const": "primary"
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chrome": {
            "const": "body-only"
          }
        },
        "required": [
          "chrome"
        ]
      },
      "then": {
        "properties": {
          "breadcrumbs": false,
          "tabs": false,
          "headerActions": false
        }
      }
    }
  ],
  "$defs": {
    "headerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
        },
        "label": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
        },
        "ariaLabel": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
        },
        "icon": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/iconToken"
        },
        "command": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/commandReference"
        },
        "when": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/condition"
        },
        "disabled": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/disabled"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "menu": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/menuItem"
          }
        },
        "presentation": {
          "enum": [
            "icon",
            "primary",
            "text"
          ]
        },
        "variant": {
          "const": "outlined"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ],
          "not": {
            "required": [
              "menu"
            ],
            "properties": {
              "menu": {}
            }
          },
          "properties": {
            "command": {}
          }
        },
        {
          "required": [
            "menu"
          ],
          "not": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {}
            }
          },
          "properties": {
            "menu": {}
          }
        }
      ],
      "not": {
        "required": [
          "icon",
          "visual"
        ],
        "properties": {
          "icon": {},
          "visual": {}
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "presentation"
            ],
            "properties": {
              "presentation": {}
            }
          },
          "then": {
            "required": [
              "command"
            ],
            "properties": {
              "command": {}
            },
            "not": {
              "required": [
                "menu"
              ],
              "properties": {
                "menu": {}
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "presentation"
            ],
            "properties": {
              "presentation": {
                "enum": [
                  "primary",
                  "text"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "visual"
              ],
              "properties": {
                "visual": {}
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "variant"
            ],
            "properties": {
              "variant": {}
            }
          },
          "then": {
            "required": [
              "presentation",
              "command"
            ],
            "properties": {
              "presentation": {
                "const": "primary"
              },
              "command": {}
            },
            "not": {
              "required": [
                "menu"
              ],
              "properties": {
                "menu": {}
              }
            }
          }
        }
      ]
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localId"
        },
        "label": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
        },
        "ariaLabel": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/localizedText"
        },
        "icon": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/iconToken"
        },
        "command": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/commandReference"
        },
        "when": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/condition"
        },
        "disabled": {
          "$ref": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/ui-common.v1.schema.json#/$defs/disabled"
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "avatar",
            "image"
          ]
        },
        "src": {
          "type": "string",
          "maxLength": 262144,
          "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "src"
            ],
            "properties": {
              "src": {}
            }
          }
        }
      ]
    }
  }
}
