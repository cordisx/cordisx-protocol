{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-common.v1.schema.json",
  "title": "CordisX Managed Service UI Common Definitions v1",
  "$defs": {
    "serviceId": {
      "$ref": "ui-common.v1.schema.json#/$defs/localId"
    },
    "pluginId": {
      "$ref": "ui-common.v1.schema.json#/$defs/localId"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "serviceId"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/pluginId"
        },
        "serviceId": {
          "$ref": "#/$defs/serviceId"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "generation"
      ],
      "properties": {
        "profileId": {
          "$ref": "ui-common.v1.schema.json#/$defs/localId"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "identity",
        "scope"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/opaqueId"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "readiness": {
      "type": "string",
      "enum": [
        "starting",
        "ready",
        "degraded",
        "stopping",
        "stopped",
        "failed"
      ]
    },
    "authState": {
      "type": "string",
      "enum": [
        "missing",
        "authenticating",
        "authenticated",
        "expired",
        "failed",
        "logged-out"
      ]
    },
    "healthLevel": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "critical"
      ]
    },
    "diagnosticCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9.-]{0,79}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "loginAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "reason"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "ready",
            "already-authenticated",
            "missing-secret",
            "service-not-ready",
            "policy-denied",
            "generation-stale"
          ]
        }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "stale-generation",
        "binding-replaced",
        "service-unavailable",
        "permission-denied",
        "not-authenticated",
        "already-authenticated",
        "authenticating",
        "authentication-failed",
        "user-cancelled",
        "timeout",
        "disposed"
      ]
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    }
  }
}
