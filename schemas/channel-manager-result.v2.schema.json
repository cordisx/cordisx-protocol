{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-result.v2.schema.json",
  "title": "CordisX Channel Manager Operation Result v2", "type": "object", "additionalProperties": false,
  "required": ["contract", "schemaVersion", "requestId", "expectedRevision", "profileId", "hostGeneration", "operation", "target", "status", "revision", "code"],
  "properties": { "contract": { "const": "cordisx.channel-manager-result/v2" }, "schemaVersion": { "const": 2 }, "requestId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/requestId" }, "expectedRevision": { "$ref": "channel-manager-common.v2.schema.json#/$defs/revision" }, "profileId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/profileId" }, "hostGeneration": { "$ref": "channel-manager-common.v2.schema.json#/$defs/hostGeneration" }, "operation": { "$ref": "channel-manager-common.v2.schema.json#/$defs/operation" }, "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/target" }, "status": { "enum": ["applied", "conflict", "rejected", "unavailable"] }, "revision": { "$ref": "channel-manager-common.v2.schema.json#/$defs/revision" }, "code": { "$ref": "channel-manager-common.v2.schema.json#/$defs/resultCode" }, "credentialDraftToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "connectionToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "expiresAt": { "type": "string", "format": "date-time" }, "permission": { "$ref": "channel-manager-common.v2.schema.json#/$defs/safePermissionReadback" } },
  "allOf": [
    { "if": { "allOf": [{ "properties": { "operation": { "const": "credential.capture" } }, "required": ["operation"] }, { "properties": { "status": { "const": "applied" } }, "required": ["status"] }] }, "then": { "required": ["credentialDraftToken", "expiresAt"], "properties": { "credentialDraftToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "expiresAt": { "type": "string", "format": "date-time" }, "permission": false } }, "else": { "properties": { "credentialDraftToken": false, "expiresAt": false } } },
    { "if": { "allOf": [{ "properties": { "operation": { "const": "connection.create" } }, "required": ["operation"] }, { "properties": { "status": { "const": "applied" } }, "required": ["status"] }] }, "then": { "required": ["connectionToken"], "properties": { "connectionToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" } } }, "else": { "properties": { "connectionToken": false } } },
    { "if": { "allOf": [{ "properties": { "operation": { "enum": ["permission.allow-once", "permission.allow-persistent", "permission.deny-once", "permission.deny-persistent"] } }, "required": ["operation"] }, { "properties": { "status": { "const": "applied" } }, "required": ["status"] }] }, "then": { "required": ["permission"], "properties": { "permission": { "$ref": "channel-manager-common.v2.schema.json#/$defs/safePermissionReadback" } } }, "else": { "properties": { "permission": false } } }
  ]
}
