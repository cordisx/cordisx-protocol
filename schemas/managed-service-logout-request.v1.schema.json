{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-logout-request.v1.schema.json",
  "title": "CordisX Managed Service Explicit Logout Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schemaVersion",
    "requestId",
    "binding",
    "action",
    "expectedSequence",
    "userGesture"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-logout-request.v1.schema.json"
    },
    "contract": { "const": "cordisx.managed-service-logout-request/v1" },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "managed-service-common.v1.schema.json#/$defs/opaqueId" },
    "binding": { "$ref": "managed-service-common.v1.schema.json#/$defs/binding" },
    "action": { "const": "logout" },
    "expectedSequence": { "$ref": "managed-service-common.v1.schema.json#/$defs/sequence" },
    "userGesture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at"],
      "properties": {
        "kind": { "const": "explicit-click" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
