{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-logout-result.v1.schema.json",
  "title": "CordisX Managed Service Explicit Logout Result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "binding", "status", "stateAt", "sequence"],
      "properties": {
        "$schema": {
          "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-logout-result.v1.schema.json"
        },
        "contract": { "const": "cordisx.managed-service-logout-result/v1" },
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "managed-service-common.v1.schema.json#/$defs/opaqueId" },
        "binding": { "$ref": "managed-service-common.v1.schema.json#/$defs/binding" },
        "status": { "const": "accepted" },
        "stateAt": { "const": "logged-out" },
        "sequence": { "$ref": "managed-service-common.v1.schema.json#/$defs/sequence" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract", "schemaVersion", "requestId", "binding", "status", "error"],
      "properties": {
        "$schema": {
          "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-logout-result.v1.schema.json"
        },
        "contract": { "const": "cordisx.managed-service-logout-result/v1" },
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "managed-service-common.v1.schema.json#/$defs/opaqueId" },
        "binding": { "$ref": "managed-service-common.v1.schema.json#/$defs/binding" },
        "status": { "enum": ["denied", "failed", "unavailable"] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "managed-service-common.v1.schema.json#/$defs/errorCode" },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  ]
}
