{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-package.v13.schema.json",
  "title": "CordisX Explicit Local Plugin Package Manifest v13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "version",
    "entry",
    "distribution",
    "compatibility",
    "dependencies",
    "runtimeManifest"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-package.v13.schema.json"
    },
    "schemaVersion": { "const": 13 },
    "id": { "$ref": "plugin-package.v12.schema.json#/properties/id" },
    "version": { "$ref": "plugin-package.v12.schema.json#/properties/version" },
    "entry": { "$ref": "plugin-package.v12.schema.json#/properties/entry" },
    "readme": { "$ref": "plugin-package.v12.schema.json#/properties/readme" },
    "canonicalSource": { "$ref": "plugin-package.v12.schema.json#/properties/canonicalSource" },
    "distribution": { "$ref": "plugin-package.v12.schema.json#/properties/distribution" },
    "compatibility": { "$ref": "plugin-package.v12.schema.json#/properties/compatibility" },
    "dependencies": { "$ref": "plugin-package.v12.schema.json#/properties/dependencies" },
    "runtimeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "digest"],
      "properties": {
        "path": { "$ref": "plugin-package.v12.schema.json#/properties/runtimeManifest/properties/path" },
        "schema": {
          "enum": [
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v1.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v2.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v3.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v4.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v5.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v8.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v9.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v10.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v11.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v12.schema.json",
            "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v13.schema.json"
          ]
        },
        "digest": { "$ref": "plugin-package.v12.schema.json#/properties/runtimeManifest/properties/digest" }
      }
    },
    "entityTemplates": { "$ref": "plugin-package.v12.schema.json#/properties/entityTemplates" }
  }
}
