{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/startup-milestone.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "target",
    "generation",
    "milestoneId",
    "sequence",
    "state"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.startup-milestone/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "capabilityId"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "plugin",
        "service"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "milestoneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "satisfied",
        "failed"
      ]
    }
  }
}
