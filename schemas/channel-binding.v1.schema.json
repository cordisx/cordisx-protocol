{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-binding.v1.schema.json",
  "title": "CordisX Channel Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "bindingId",
    "channel",
    "session",
    "createdBy",
    "createdFrom",
    "routeId",
    "revision",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "contract": { "const": "cordisx.channel-binding/v1" },
    "schemaVersion": { "const": 1 },
    "bindingId": { "$ref": "channel-common.v1.schema.json#/$defs/opaqueId" },
    "channel": { "$ref": "channel-common.v1.schema.json#/$defs/threadRef" },
    "session": { "$ref": "platform-session.v1.schema.json#/$defs/sessionRef" },
    "createdBy": { "$ref": "channel-common.v1.schema.json#/$defs/userRef" },
    "createdFrom": { "$ref": "channel-common.v1.schema.json#/$defs/eventRef" },
    "routeId": { "$ref": "channel-common.v1.schema.json#/$defs/opaqueId" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "archived", "unavailable"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
