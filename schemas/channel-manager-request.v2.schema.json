{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-request.v2.schema.json",
  "title": "CordisX Channel Manager Operation Request v2", "type": "object", "additionalProperties": false,
  "required": ["contract", "schemaVersion", "requestId", "expectedRevision", "profileId", "hostGeneration", "operation", "target"],
  "properties": { "contract": { "const": "cordisx.channel-manager-request/v2" }, "schemaVersion": { "const": 2 }, "requestId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/requestId" }, "expectedRevision": { "$ref": "channel-manager-common.v2.schema.json#/$defs/revision" }, "profileId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/profileId" }, "hostGeneration": { "$ref": "channel-manager-common.v2.schema.json#/$defs/hostGeneration" }, "operation": { "$ref": "channel-manager-common.v2.schema.json#/$defs/operation" }, "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/target" }, "draft": {}, "patch": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionUpdatePatch" }, "query": { "$ref": "channel-manager-common.v2.schema.json#/$defs/logQuery" } },
  "allOf": [
    { "if": { "properties": { "operation": { "const": "credential.capture" } }, "required": ["operation"] }, "then": { "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/credentialCaptureTarget" }, "draft": false, "patch": false, "query": false } } },
    { "if": { "properties": { "operation": { "const": "connection.create" } }, "required": ["operation"] }, "then": { "required": ["draft"], "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionDraftTarget" }, "draft": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionCreatePatch" }, "patch": false, "query": false } } },
    { "if": { "properties": { "operation": { "const": "connection.rotate-credential" } }, "required": ["operation"] }, "then": { "required": ["draft"], "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionTarget" }, "draft": { "$ref": "channel-manager-common.v2.schema.json#/$defs/credentialRotationDraft" }, "patch": false, "query": false } } },
    { "if": { "properties": { "operation": { "const": "connection.update" } }, "required": ["operation"] }, "then": { "required": ["patch"], "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionTarget" }, "draft": false, "patch": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionUpdatePatch" }, "query": false } } },
    { "if": { "properties": { "operation": { "enum": ["connection.enable", "connection.disable", "connection.reconnect"] } }, "required": ["operation"] }, "then": { "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/connectionTarget" }, "draft": false, "patch": false, "query": false } } },
    { "if": { "properties": { "operation": { "enum": ["binding.open", "binding.archive", "binding.restore", "binding.unbind"] } }, "required": ["operation"] }, "then": { "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/bindingTarget" }, "draft": false, "patch": false, "query": false } } },
    { "if": { "properties": { "operation": { "enum": ["logs.query", "logs.export"] } }, "required": ["operation"] }, "then": { "required": ["query"], "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/logTarget" }, "draft": false, "patch": false, "query": { "$ref": "channel-manager-common.v2.schema.json#/$defs/logQuery" } } } },
    { "if": { "properties": { "operation": { "enum": ["permission.allow-once", "permission.allow-persistent", "permission.deny-once", "permission.deny-persistent"] } }, "required": ["operation"] }, "then": { "properties": { "target": { "$ref": "channel-manager-common.v2.schema.json#/$defs/permissionRequestTarget" }, "draft": false, "patch": false, "query": false } } }
  ]
}
