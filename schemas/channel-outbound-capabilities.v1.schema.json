{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-outbound-capabilities.v1.schema.json",
  "title": "CordisX channel-outbound-capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "target",
    "types",
    "maxMediaBytes"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-outbound-capabilities/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "$ref": "channel-common.v1.schema.json#/$defs/threadRef"
    },
    "types": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 7,
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "file",
          "video",
          "richtext",
          "card"
        ]
      }
    },
    "maxMediaBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000000
    }
  }
}
