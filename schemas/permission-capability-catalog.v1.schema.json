{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-capability-catalog.v1.schema.json",
  "title": "CordisX Host Capability Risk Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogVersion", "entries"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/permission-capability-catalog.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "providerFamily",
          "sensitivity",
          "recommendedPolicy",
          "persistentAllow",
          "persistentDeny",
          "maximumScope",
          "scopeUpgrade",
          "installPrompt",
          "runtimePrompt",
          "presentation"
        ],
        "properties": {
          "capability": { "$ref": "permission-common.v2.schema.json#/$defs/capability" },
          "providerFamily": { "enum": ["platform", "agent", "channel"] },
          "sensitivity": { "enum": ["low", "general", "sensitive", "high-risk"] },
          "recommendedPolicy": { "$ref": "permission-common.v2.schema.json#/$defs/policy" },
          "persistentAllow": { "type": "boolean" },
          "persistentDeny": { "type": "boolean" },
          "maximumScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowedDimensions", "unscopedAllowed"],
            "properties": {
              "allowedDimensions": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "providers",
                    "cwdRoots",
                    "sessions",
                    "sessionIds",
                    "channelAccounts",
                    "channelTenants",
                    "channelConversations",
                    "channelUsers"
                  ]
                }
              },
              "unscopedAllowed": { "type": "boolean" }
            }
          },
          "scopeUpgrade": { "enum": ["any-change", "strict-expansion"] },
          "installPrompt": { "enum": ["batch-eligible", "explicit"] },
          "runtimePrompt": { "enum": ["first-use", "dynamic-scope", "always"] },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "risk", "limitation"],
            "properties": {
              "name": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "description": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "risk": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
              "limitation": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" }
            }
          }
        }
      }
    }
  }
}
