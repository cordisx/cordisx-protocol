{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-runtime-snapshot.v3.schema.json",
  "title": "CordisX Channel Manager Runtime Snapshot v3", "type": "object", "additionalProperties": false,
  "required": ["contract", "schemaVersion", "profileId", "hostGeneration", "revision", "observedAt", "availableOperations", "accounts", "bindings", "pendingAuthorizations"],
  "properties": { "contract": { "const": "cordisx.channel-runtime-snapshot/v3" }, "schemaVersion": { "const": 3 }, "profileId": { "$ref": "channel-manager-common.v2.schema.json#/$defs/profileId" }, "hostGeneration": { "$ref": "channel-manager-common.v2.schema.json#/$defs/hostGeneration" }, "revision": { "$ref": "channel-manager-common.v2.schema.json#/$defs/revision" }, "observedAt": { "type": "string", "format": "date-time" }, "availableOperations": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["credential.capture", "connection.create", "target.credential.capture.create", "target.connection.create", "target.connection.create.simulator"] } }, "accounts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/account" } }, "bindings": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/binding" } }, "pendingAuthorizations": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/pendingAuthorization" } } },
  "$defs": {
    "queue": { "type": "object", "additionalProperties": false, "required": ["pending", "retrying", "deadLetter"], "properties": { "pending": { "type": "integer", "minimum": 0 }, "retrying": { "type": "integer", "minimum": 0 }, "deadLetter": { "type": "integer", "minimum": 0 } } },
    "account": { "type": "object", "additionalProperties": false, "required": ["connectionToken", "adapterKind", "implementationStatus", "connectionState", "configurationState", "generation", "lastGoodRevision", "inbound", "outbound", "availableOperations"], "properties": { "connectionToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "adapterKind": { "$ref": "channel-service-config.v1.schema.json#/$defs/adapterKind" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 256 }, "implementationStatus": { "enum": ["implemented", "verified", "experimental", "unavailable", "planned"] }, "connectionState": { "enum": ["disabled", "starting", "ready", "retrying", "unavailable", "stopped"] }, "configurationState": { "enum": ["ready", "incomplete", "unavailable"] }, "generation": { "type": "integer", "minimum": 1 }, "lastGoodRevision": { "type": "integer", "minimum": 0 }, "cursorUpdatedAt": { "type": "string", "format": "date-time" }, "lastErrorCode": { "$ref": "channel-manager-common.v2.schema.json#/$defs/resultCode" }, "inbound": { "$ref": "#/$defs/queue" }, "outbound": { "$ref": "#/$defs/queue" }, "availableOperations": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["connection.update", "connection.rotate-credential", "connection.enable", "connection.disable", "connection.reconnect", "logs.query", "logs.export", "target.credential.capture.rotate"] } } } },
    "pendingAuthorization": { "type": "object", "additionalProperties": false, "required": ["permissionRequestToken", "capability", "state", "availableOperations"], "properties": { "permissionRequestToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "capability": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9.-]{0,127}$" }, "state": { "const": "pending" }, "availableOperations": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["permission.allow-once", "permission.allow-persistent", "permission.deny-once", "permission.deny-persistent"] } } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["bindingToken", "connectionToken", "sessionToken", "routeToken", "bindingRevision", "state", "availableOperations"], "properties": { "bindingToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "connectionToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "sessionToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "routeToken": { "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken" }, "bindingRevision": { "type": "integer", "minimum": 1 }, "state": { "enum": ["active", "archived", "unavailable"] }, "availableOperations": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["binding.archive", "binding.restore", "binding.unbind"] } } } }
  }
}
