{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/transient-canvas-registration.v1.schema.json",
  "title": "CordisX Transient Canvas Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "pointId", "durationMs", "reducedMotion"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/transient-canvas-registration.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "pointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "durationMs": { "type": "integer", "minimum": 100, "maximum": 5000 },
    "reducedMotion": { "enum": ["skip", "static"] }
  }
}
