{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v2.schema.json",
  "title": "CordisX Runtime Plugin Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "capabilities", "services"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v2.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capabilities": {
      "type": "array",
      "maxItems": 19,
      "items": { "$ref": "#/$defs/capabilityDeclaration" }
    },
    "services": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/serviceDeclaration" }
    }
  },
  "$defs": {
    "capabilityName": {
      "enum": [
        "models.read",
        "tasks.catalog.read",
        "tasks.content.read",
        "tasks.create",
        "tasks.control",
        "turns.submit",
        "turns.control",
        "agent.events.read",
        "agent.messages.append",
        "agent.steps.reject",
        "agent.messages.transform",
        "agent.prompt.section",
        "agent.prompt.context",
        "channel.accounts.connect",
        "channel.events.receive",
        "channel.messages.send",
        "channel.bindings.read",
        "channel.bindings.write",
        "channel.attachments.read"
      ]
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "platformSessionRef": {
      "$ref": "platform-session.v1.schema.json#/$defs/sessionRef"
    },
    "agentSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/providerId" }
        },
        "cwdRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:/.*|[A-Za-z]:[\\\\/].*|\\\\\\\\.+)$"
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platformSessionRef" }
        },
        "sessionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/agentSessionId" }
        },
        "channelAccounts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/accountRef" }
        },
        "channelTenants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/tenantRef" }
        },
        "channelConversations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/conversationRef" }
        },
        "channelUsers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "channel-common.v1.schema.json#/$defs/userRef" }
        }
      }
    },
    "capabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "reason", "scope"],
      "properties": {
        "name": { "$ref": "#/$defs/capabilityName" },
        "required": { "type": "boolean" },
        "reason": { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "serviceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entry"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "kind": { "const": "channel-adapter" },
        "entry": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:cjs|mjs|js)$"
        }
      }
    }
  }
}
