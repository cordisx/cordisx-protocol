{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-event-page.v2.schema.json",
  "title": "CordisX Agent Event Page v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "sessionId", "snapshotSeq", "afterSeq", "limit", "events"],
  "properties": {
    "contract": { "const": "cordisx.agent-events/v2" },
    "schemaVersion": { "const": 2 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "snapshotSeq": { "type": "integer", "minimum": -1 },
    "afterSeq": { "type": "integer", "minimum": -1 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
    "fromSeq": { "type": "integer", "minimum": 0 },
    "toSeq": { "type": "integer", "minimum": 0 },
    "nextAfterSeq": { "type": "integer", "minimum": 0 },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "agent-event.v2.schema.json" }
    }
  }
}
