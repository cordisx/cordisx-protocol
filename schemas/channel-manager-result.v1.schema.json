{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-result.v1.schema.json",
  "title": "CordisX Channel Manager Operation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "requestId", "expectedRevision", "profileId", "hostGeneration", "operation", "target", "status", "revision", "observedAt"],
  "properties": {
    "contract": { "const": "cordisx.channel-manager-result/v1" },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "channel-manager-common.v1.schema.json#/$defs/requestId" },
    "expectedRevision": { "$ref": "channel-manager-common.v1.schema.json#/$defs/revision" },
    "profileId": { "$ref": "channel-manager-common.v1.schema.json#/$defs/profileId" },
    "hostGeneration": { "$ref": "channel-manager-common.v1.schema.json#/$defs/hostGeneration" },
    "operation": { "$ref": "channel-manager-common.v1.schema.json#/$defs/operation" },
    "target": { "$ref": "channel-manager-common.v1.schema.json#/$defs/target" },
    "status": { "enum": ["applied", "conflict", "rejected", "unavailable"] },
    "revision": { "$ref": "channel-manager-common.v1.schema.json#/$defs/revision" },
    "observedAt": { "type": "string", "format": "date-time" },
    "credentialDraftToken": { "$ref": "channel-manager-common.v1.schema.json#/$defs/opaqueToken" },
    "code": { "$ref": "channel-manager-common.v1.schema.json#/$defs/resultCode" },
    "retryable": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "applied" } }, "required": ["status"] },
      "then": { "properties": { "code": false, "retryable": false } },
      "else": { "required": ["code", "retryable"] }
    }
    ,
    {
      "if": {
        "allOf": [
          { "properties": { "operation": { "const": "credential.capture" } }, "required": ["operation"] },
          { "properties": { "status": { "const": "applied" } }, "required": ["status"] }
        ]
      },
      "then": { "required": ["credentialDraftToken"], "properties": { "credentialDraftToken": {} } },
      "else": { "properties": { "credentialDraftToken": false } }
    }
  ]
}
