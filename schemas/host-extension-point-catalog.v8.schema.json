{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-extension-point-catalog.v8.schema.json",
  "title": "CordisX Host Extension Point Catalog v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "points"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-extension-point-catalog.v8.schema.json" },
    "schemaVersion": { "const": 8 },
    "points": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "host-extension-point-catalog.v7.schema.json#/$defs/sessionBackdropDescriptor" },
          { "$ref": "host-extension-point-catalog.v6.schema.json#/$defs/descriptor" },
          { "$ref": "#/$defs/transientCanvasDescriptor" }
        ]
      }
    }
  },
  "$defs": {
    "descriptorText": {
      "allOf": [
        { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
        { "type": "object", "required": ["fallback"], "properties": { "fallback": true } }
      ]
    },
    "transientCanvasDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "description", "icon", "payloadFamily", "maturity", "adapterSupport"],
      "properties": {
        "id": { "const": "composer.submit.effects" },
        "kind": { "const": "surface" },
        "title": { "$ref": "#/$defs/descriptorText" },
        "description": { "$ref": "#/$defs/descriptorText" },
        "icon": { "$ref": "ui-common.v1.schema.json#/$defs/hostIconToken" },
        "payloadFamily": { "const": "transient-canvas-presentation" },
        "maturity": { "const": "experimental" },
        "adapterSupport": { "const": "supported" }
      }
    }
  }
}
