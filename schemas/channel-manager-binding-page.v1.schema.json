{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-binding-page.v1.schema.json",
  "title": "CordisX Channel Manager binding page v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "profileId",
    "hostGeneration",
    "connectionToken",
    "snapshotRevision",
    "total",
    "bindings"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-manager-binding-page/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hostGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "connectionToken": {
      "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken"
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "bindings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "channel-runtime-snapshot.v3.schema.json#/$defs/binding"
      }
    },
    "nextCursor": {
      "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken"
    }
  }
}
