{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-subscription-page.v1.schema.json",
  "title": "CordisX Session Subscription Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "sessionId", "sessionGeneration", "subscriptionGeneration", "replayThrough", "phase", "events"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/session-subscription-page.v1.schema.json" },
    "contract": { "const": "cordisx.session-subscription-page/v1" },
    "schemaVersion": { "const": 1 },
    "sessionId": { "$ref": "session-common.v1.schema.json#/$defs/opaqueId" },
    "sessionGeneration": { "$ref": "session-common.v1.schema.json#/$defs/generation" },
    "subscriptionGeneration": { "$ref": "session-common.v1.schema.json#/$defs/generation" },
    "replayThrough": { "$ref": "session-common.v1.schema.json#/$defs/cursor" },
    "phase": { "enum": ["replay", "live"] },
    "events": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "session-event.v1.schema.json" } }
  }
}
