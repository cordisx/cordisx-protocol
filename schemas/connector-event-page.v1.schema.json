{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-event-page.v1.schema.json",
  "title": "CordisX Connector Event Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "subscription", "afterSequence", "phase", "events", "nextAfterSequence", "hasMore"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/connector-event-page.v1.schema.json" },
    "contract": { "const": "cordisx.connector-event-page/v1" },
    "schemaVersion": { "const": 1 },
    "subscription": { "$ref": "connector-event-subscription.v1.schema.json" },
    "afterSequence": { "type": "integer", "minimum": -1 },
    "phase": { "enum": ["replay", "live"] },
    "events": { "type": "array", "maxItems": 256, "items": { "$ref": "connector-event.v1.schema.json" } },
    "nextAfterSequence": { "type": "integer", "minimum": -1 },
    "hasMore": { "type": "boolean" }
  }
}
