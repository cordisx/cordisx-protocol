{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/managed-service-web-entry-proof.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "instance",
    "proof"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.managed-service-web-entry-proof/v1"
    },
    "instance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "proof": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
