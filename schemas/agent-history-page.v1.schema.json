{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-history-page.v1.schema.json",
  "title": "CordisX Agent History Page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "sessionId", "snapshotId", "limit", "requestedPayloadPolicy", "effectivePayloadPolicy", "source", "coverage", "events"],
  "properties": {
    "contract": { "const": "cordisx.agent-history/v1" },
    "schemaVersion": { "const": 1 },
    "sessionId": { "$ref": "agent-event.v1.schema.json#/$defs/opaqueId" },
    "snapshotId": { "$ref": "#/$defs/opaqueToken" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
    "requestedPayloadPolicy": { "$ref": "#/$defs/payloadPolicy" },
    "effectivePayloadPolicy": { "$ref": "#/$defs/payloadPolicy" },
    "source": { "$ref": "#/$defs/historySource" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "fromSeq": { "type": "integer", "minimum": 0 },
    "toSeq": { "type": "integer", "minimum": 0 },
    "nextCursor": { "$ref": "#/$defs/opaqueToken" },
    "tailCursor": { "$ref": "#/$defs/opaqueToken" },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "agent-event.v2.schema.json" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/historyDiagnostic" }
    }
  },
  "$defs": {
    "opaqueToken": {
      "type": "string",
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "payloadPolicy": { "enum": ["referenced", "summarized", "inline"] },
    "historySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapterId", "adapterVersion", "hostId", "profileId"],
      "properties": {
        "kind": { "const": "historical" },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "hostId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "profileId": { "$ref": "#/$defs/opaqueToken" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "compacted", "corruptLines", "oversizedLines", "redactedFields", "tailAvailable"],
      "properties": {
        "state": { "enum": ["complete", "partial", "indexing", "unavailable"] },
        "earliestTime": { "type": "integer", "minimum": 0 },
        "latestTime": { "type": "integer", "minimum": 0 },
        "compacted": { "type": "boolean" },
        "corruptLines": { "type": "integer", "minimum": 0 },
        "oversizedLines": { "type": "integer", "minimum": 0 },
        "redactedFields": { "type": "integer", "minimum": 0 },
        "tailAvailable": { "type": "boolean" }
      }
    },
    "historyDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "count"],
      "properties": {
        "code": { "enum": ["history-unavailable", "history-indexing", "history-corrupt-line", "history-oversized-line", "history-source-changed", "history-content-redacted", "history-resource-limit"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
