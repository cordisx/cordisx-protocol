{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-lifecycle-operation.v3.schema.json",
  "title": "CordisX Plugin Lifecycle Operation v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "requestId", "profileId", "expectedRevision", "runtimeGeneration", "operation"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-lifecycle-operation.v3.schema.json"
    },
    "schemaVersion": { "const": 3 },
    "requestId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
    "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "expectedRevision": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/revision" },
    "runtimeGeneration": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/generation" },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "source"],
          "properties": {
            "kind": { "const": "inspect-source" },
            "source": { "$ref": "plugin-package-source.v1.schema.json#/$defs/source" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidateId", "authorizationDecision"],
          "properties": {
            "kind": { "enum": ["install", "update"] },
            "candidateId": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" },
            "authorizationDecision": { "$ref": "permission-authorization-decision.v2.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId"],
          "properties": {
            "kind": { "const": "enable" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "authorizationDecision": { "$ref": "permission-authorization-decision.v2.schema.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId"],
          "properties": {
            "kind": { "const": "reload" },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pluginId", "impactToken"],
          "properties": {
            "kind": { "enum": ["disable", "uninstall"] },
            "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
            "impactToken": { "$ref": "plugin-lifecycle-common.v1.schema.json#/$defs/transactionId" }
          }
        }
      ]
    }
  }
}
