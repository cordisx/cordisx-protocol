{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-forward.v1.schema.json",
  "title": "Channel independent forwarding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "operation", "operationId", "source", "target", "messageIds"],
  "properties": {
    "contract": { "const": "cordisx.channel-forward/v1" },
    "schemaVersion": { "const": 1 },
    "operation": { "enum": ["forward", "merge-forward"] },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "source": { "$ref": "channel-common.v1.schema.json#/$defs/conversationRef" },
    "target": { "$ref": "channel-common.v1.schema.json#/$defs/conversationRef" },
    "messageIds": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "forward" } } },
      "then": { "properties": { "messageIds": { "type": "array", "maxItems": 1 } } },
      "else": { "properties": { "messageIds": { "type": "array", "minItems": 2 } } }
    }
  ]
}
