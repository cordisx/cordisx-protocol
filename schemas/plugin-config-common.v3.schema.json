{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-config-common.v3.schema.json",
  "title": "CordisX Plugin Configuration Common Definitions v3",
  "$defs": {
    "identity": { "$ref": "plugin-config-common.v2.schema.json#/$defs/identity" },
    "scope": { "$ref": "plugin-config-common.v2.schema.json#/$defs/scope" },
    "pathSegment": { "$ref": "plugin-config-common.v2.schema.json#/$defs/pathSegment" },
    "fieldPath": { "$ref": "plugin-config-common.v2.schema.json#/$defs/fieldPath" },
    "secretSlot": { "$ref": "plugin-config-common.v2.schema.json#/$defs/secretSlot" },
    "applies": { "$ref": "plugin-config-common.v2.schema.json#/$defs/applies" },
    "choiceScalar": {
      "oneOf": [
        { "type": "string", "maxLength": 4096 },
        { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "localizedChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "$ref": "#/$defs/choiceScalar" },
        "label": {
          "allOf": [
            { "$ref": "ui-common.v1.schema.json#/$defs/localizedText" },
            { "type": "object", "required": ["fallback"], "properties": { "fallback": true } }
          ]
        }
      }
    },
    "formFieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/fieldPath" },
        "icon": { "$ref": "plugin-config-common.v1.schema.json#/$defs/formIcon" },
        "group": { "$ref": "plugin-config-common.v1.schema.json#/$defs/formGroup" },
        "presenter": { "$ref": "plugin-config-common.v1.schema.json#/$defs/formPresenter" },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/localizedChoice" }
        }
      }
    },
    "formPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fields"],
      "properties": {
        "version": { "const": 2 },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/formFieldPresentation" }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "save": { "$ref": "plugin-config-common.v1.schema.json#/$defs/formIcon" },
            "reset": { "$ref": "plugin-config-common.v1.schema.json#/$defs/formIcon" }
          }
        }
      }
    },
    "schemaProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "envelope"],
          "properties": {
            "kind": { "const": "schemastery" },
            "envelope": { "type": "object", "maxProperties": 100 },
            "form": { "$ref": "#/$defs/formPresentation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "renderable"],
          "properties": {
            "kind": { "const": "standard" },
            "renderable": { "const": false }
          }
        }
      ]
    }
  }
}
