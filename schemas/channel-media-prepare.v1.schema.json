{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-media-prepare.v1.schema.json",
  "title": "CordisX channel-media-prepare v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "target",
    "type",
    "input"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-media-prepare/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "$ref": "channel-common.v1.schema.json#/$defs/threadRef"
    },
    "type": {
      "enum": [
        "image",
        "audio",
        "file",
        "video"
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "source"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^chsource:[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bytesBase64",
            "sha256",
            "size",
            "mediaType",
            "format"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "bytesBase64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 174764,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 131072
            },
            "mediaType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?!\\s)(?!.*\\s$)(?!\\.{1,2}$)(?!.*\\.$)[^/\\\\\\u0000-\\u001f\\u007f]+$"
            },
            "format": {
              "enum": [
                "png",
                "jpeg",
                "opus",
                "mp4",
                "pdf",
                "binary"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "format": {
                    "const": "pdf"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "type": "object",
                "required": [
                  "filename"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "pattern": "\\.[pP][dD][fF]$"
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "properties": {
                  "format": {
                    "const": "mp4"
                  }
                },
                "required": [
                  "format"
                ]
              },
              "then": {
                "type": "object",
                "required": [
                  "filename"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "pattern": "\\.[mM][pP]4$"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "image"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "input": {
            "if": {
              "properties": {
                "kind": {
                  "const": "bytes"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "format": {
                  "enum": [
                    "png",
                    "jpeg"
                  ]
                },
                "durationMs": false
              },
              "type": "object"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audio"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "input": {
            "if": {
              "properties": {
                "kind": {
                  "const": "bytes"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "format": {
                  "enum": [
                    "opus"
                  ]
                }
              },
              "type": "object"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "input": {
            "if": {
              "properties": {
                "kind": {
                  "const": "bytes"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "format": {
                  "enum": [
                    "pdf",
                    "binary"
                  ]
                },
                "durationMs": false,
                "filename": {}
              },
              "required": [
                "filename"
              ],
              "type": "object"
            }
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "video"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "input": {
            "if": {
              "properties": {
                "kind": {
                  "const": "bytes"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "format": {
                  "enum": [
                    "mp4"
                  ]
                },
                "filename": {}
              },
              "required": [
                "filename"
              ],
              "type": "object"
            }
          }
        },
        "type": "object"
      }
    }
  ]
}
