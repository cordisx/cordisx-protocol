{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/extension-point-control-declaration.v1.schema.json",
  "title": "CordisX Extension Point Control Claim v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "origin", "identity", "claimId", "contributionId", "mode", "priority", "requestedBindings"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/extension-point-control-declaration.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "origin": { "enum": ["explicit", "legacy-structured"] },
    "identity": { "$ref": "extension-point-common.v1.schema.json#/$defs/canonicalIdentity" },
    "claimId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "contributionId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
    "mode": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/mode" },
    "priority": { "type": "integer", "minimum": -100000, "maximum": 100000 },
    "requestedBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties", "commands", "events"],
      "properties": {
        "properties": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" }
        },
        "events": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "extension-point-control-common.v1.schema.json#/$defs/bindingId" }
        }
      }
    }
  }
}
