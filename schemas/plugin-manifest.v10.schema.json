{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v10.schema.json",
  "title": "CordisX Runtime Plugin Manifest v10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "capabilities",
    "services"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v10.schema.json"
    },
    "schemaVersion": {
      "const": 10
    },
    "id": {
      "$ref": "ui-common.v1.schema.json#/$defs/localId"
    },
    "name": {
      "$ref": "plugin-manifest.v5.schema.json#/properties/name"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 36,
      "items": {
        "oneOf": [
          {
            "$ref": "plugin-manifest.v9.schema.json#/$defs/capabilityDeclaration"
          },
          {
            "$ref": "#/$defs/interactionCapability"
          }
        ]
      }
    },
    "services": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/serviceDeclaration"
      }
    }
  },
  "$defs": {
    "agentRuntimeCapability": {
      "$ref": "agents-common.v1.schema.json#/$defs/capability"
    },
    "approvalCapability": {
      "enum": [
        "approvals.request",
        "approvals.answer"
      ]
    },
    "exactSessionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^*]+$"
      }
    },
    "hostRouteSessionScopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "routeId",
        "param"
      ],
      "properties": {
        "kind": {
          "const": "host-route-param"
        },
        "routeId": {
          "$ref": "ui-common.v1.schema.json#/$defs/localId"
        },
        "param": {
          "const": "sessionId"
        }
      }
    },
    "approvalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionIds"
      ],
      "properties": {
        "sessionIds": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactSessionIds"
            },
            {
              "$ref": "#/$defs/hostRouteSessionScopeBinding"
            }
          ]
        }
      }
    },
    "approvalAuthorityRequesterRouteScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRequester"
      ],
      "properties": {
        "authorityRequester": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requester"
          ],
          "properties": {
            "kind": {
              "const": "approval-authority-requester-route"
            },
            "requester": {
              "$ref": "#/$defs/hostRouteSessionScopeBinding"
            }
          }
        }
      }
    },
    "agentRuntimeScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionIds": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactSessionIds"
            },
            {
              "$ref": "#/$defs/hostRouteSessionScopeBinding"
            }
          ]
        },
        "authorityRequester": {
          "$ref": "#/$defs/approvalAuthorityRequesterRouteScope/properties/authorityRequester"
        }
      }
    },
    "agentRuntimeCapabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required",
        "scope"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/agentRuntimeCapability"
        },
        "required": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "plugin-manifest.v5.schema.json#/$defs/rationale"
        },
        "security": {
          "$ref": "plugin-manifest.v5.schema.json#/$defs/securityDeclaration"
        },
        "scope": {
          "$ref": "#/$defs/agentRuntimeScope"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "approvals.request"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "$ref": "#/$defs/approvalScope"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "approvals.answer"
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/approvalScope"
                  },
                  {
                    "$ref": "#/$defs/approvalAuthorityRequesterRouteScope"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "type": "object",
                "properties": {
                  "authorityRequester": true
                },
                "required": [
                  "authorityRequester"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "name": {
                "const": "approvals.answer"
              },
              "required": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "type": "object",
                "properties": {
                  "sessionIds": {
                    "type": "object"
                  }
                },
                "required": [
                  "sessionIds"
                ]
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "capabilityDeclaration": {
      "oneOf": [
        {
          "$ref": "plugin-manifest.v5.schema.json#/$defs/capabilityDeclaration"
        },
        {
          "$ref": "#/$defs/agentRuntimeCapabilityDeclaration"
        }
      ]
    },
    "platformProviderService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner",
        "schema",
        "applicationMode",
        "entry"
      ],
      "properties": {
        "id": {
          "$ref": "ui-common.v1.schema.json#/$defs/localId"
        },
        "kind": {
          "const": "platform-provider"
        },
        "owner": {
          "const": "host"
        },
        "schema": {
          "type": "string",
          "format": "uri",
          "maxLength": 512,
          "pattern": "^https://raw\\.githubusercontent\\.com/cordisx/cordisx-protocol/main/schemas/[a-z0-9][a-z0-9.-]*\\.v[1-9][0-9]*\\.schema\\.json$"
        },
        "applicationMode": {
          "enum": [
            "service-restart",
            "app-restart"
          ]
        },
        "entry": {
          "$ref": "plugin-manifest.v5.schema.json#/$defs/serviceDeclaration/properties/entry"
        }
      }
    },
    "serviceDeclaration": {
      "oneOf": [
        {
          "$ref": "plugin-manifest.v5.schema.json#/$defs/serviceDeclaration"
        },
        {
          "$ref": "#/$defs/platformProviderService"
        }
      ]
    },
    "interactionCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required",
        "scope"
      ],
      "properties": {
        "name": {
          "const": "ui.extension-points.interact"
        },
        "required": {
          "type": "boolean"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extensionPoints",
            "events"
          ],
          "properties": {
            "extensionPoints": {
              "$ref": "permission-common.v5.schema.json#/$defs/scope/properties/extensionPoints"
            },
            "events": {
              "$ref": "extension-point-visual.v1.schema.json#/$defs/nonemptyEvents"
            }
          }
        }
      }
    }
  }
}
