{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-command.v1.schema.json",
  "title": "CordisX Agent Loop Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract", "schemaVersion", "commandId", "type"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/agent-loop-command.v1.schema.json" },
    "contract": { "const": "cordisx.agent-loop-command/v1" },
    "schemaVersion": { "const": 1 },
    "commandId": { "$ref": "agent-loop-common.v1.schema.json#/$defs/opaqueHandle" },
    "type": { "enum": ["create-or-bind", "send"] },
    "definition": { "$ref": "agent-loop-common.v1.schema.json#/$defs/definitionIdentity" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "agent-definition.v1.schema.json" }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "create" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "task"],
          "properties": {
            "mode": { "const": "bind" },
            "task": { "$ref": "agent-loop-common.v1.schema.json#/$defs/opaqueHandle" }
          }
        }
      ]
    },
    "binding": { "$ref": "agent-loop-task-binding.v1.schema.json" },
    "content": { "$ref": "agent-loop-common.v1.schema.json#/$defs/content" }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "create-or-bind" } } },
      "then": {
        "required": ["definition", "definitions", "target"],
        "properties": { "definition": true, "definitions": true, "target": true, "binding": false, "content": false }
      }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "send" } } },
      "then": {
        "required": ["binding", "content"],
        "properties": { "definition": false, "definitions": false, "target": false, "binding": true, "content": true }
      }
    }
  ]
}
