{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/channel-manager-conversation-activity-page.v1.schema.json",
  "title": "channel-manager-conversation-activity-page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "profileId",
    "hostGeneration",
    "snapshotRevision",
    "conversationToken",
    "source",
    "total",
    "entries"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.channel-manager-conversation-activity-page/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "hostGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "conversationToken": {
      "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken"
    },
    "source": {
      "const": "local-transport"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "channel-manager-conversations.v1.schema.json#/$defs/activity"
      }
    },
    "nextCursor": {
      "$ref": "channel-manager-common.v2.schema.json#/$defs/opaqueToken"
    }
  }
}
