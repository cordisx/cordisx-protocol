{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-config-common.v1.schema.json",
  "title": "CordisX Plugin Configuration Common Definitions v1",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "pluginId"],
      "properties": {
        "source": { "$ref": "extension-point-common.v1.schema.json#/$defs/canonicalSource" },
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "generation"],
      "properties": {
        "profileId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "pathSegment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": { "enum": ["__proto__", "prototype", "constructor"] }
    },
    "fieldPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/pathSegment" }
    },
    "formIcon": {
      "enum": [
        "host:calendar",
        "host:clock",
        "host:palette",
        "host:tags",
        "host:folder",
        "host:key",
        "host:settings",
        "host:info",
        "host:files",
        "host:save",
        "host:reset"
      ]
    },
    "formLocalizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 400 },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z0-9-]{2,32}$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      ]
    },
    "formGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "title": { "$ref": "#/$defs/formLocalizedText" },
        "description": { "$ref": "#/$defs/formLocalizedText" },
        "icon": { "$ref": "#/$defs/formIcon" }
      }
    },
    "formPresenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kind"],
      "properties": {
        "version": { "const": 1 },
        "kind": {
          "enum": [
            "choice.select", "choice.radio", "choice.segmented",
            "number.input", "number.stepper", "number.slider",
            "array.scalar-tags", "array.scalar-rows",
            "array.object-auto", "array.object-dialog", "array.object-page"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "density": { "enum": ["compact", "regular"] },
            "maxInlineItems": { "type": "integer", "minimum": 1, "maximum": 64 },
            "allowReorder": { "type": "boolean" }
          }
        }
      }
    },
    "formFieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/fieldPath" },
        "icon": { "$ref": "#/$defs/formIcon" },
        "group": { "$ref": "#/$defs/formGroup" },
        "presenter": { "$ref": "#/$defs/formPresenter" }
      }
    },
    "formPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fields"],
      "properties": {
        "version": { "const": 1 },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/formFieldPresentation" }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "save": { "$ref": "#/$defs/formIcon" },
            "reset": { "$ref": "#/$defs/formIcon" }
          }
        }
      }
    },
    "schemaProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "envelope"],
          "properties": {
            "kind": { "const": "schemastery" },
            "envelope": { "type": "object", "maxProperties": 100 },
            "form": { "$ref": "#/$defs/formPresentation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "renderable"],
          "properties": {
            "kind": { "const": "standard" },
            "renderable": { "const": false }
          }
        }
      ]
    },
    "secretSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "set"],
      "properties": {
        "path": { "$ref": "#/$defs/fieldPath" },
        "set": { "type": "boolean" }
      }
    },
    "applies": { "enum": ["live", "restart"] }
  }
}
