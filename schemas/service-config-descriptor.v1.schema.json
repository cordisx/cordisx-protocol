{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/service-config-descriptor.v1.schema.json",
  "title": "CordisX Host Service Configuration Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaVersion",
    "identity",
    "scope",
    "schema",
    "revision",
    "lastGoodRevision",
    "configApplies",
    "writable",
    "restartRequired",
    "configuration",
    "secrets"
  ],
  "properties": {
    "contract": { "const": "cordisx.service-config-descriptor/v1" },
    "schemaVersion": { "const": 1 },
    "identity": { "$ref": "service-config-common.v1.schema.json#/$defs/identity" },
    "scope": { "$ref": "service-config-common.v1.schema.json#/$defs/scope" },
    "schema": { "$ref": "service-config-common.v1.schema.json#/$defs/schema" },
    "revision": { "type": "integer", "minimum": 0 },
    "lastGoodRevision": { "type": "integer", "minimum": 0 },
    "configApplies": { "$ref": "service-config-common.v1.schema.json#/$defs/configApplies" },
    "writable": { "type": "boolean" },
    "restartRequired": { "type": "boolean" },
    "configuration": { "$ref": "ui-common.v1.schema.json#/$defs/jsonValue" },
    "activeConfiguration": { "$ref": "ui-common.v1.schema.json#/$defs/jsonValue" },
    "secrets": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "service-config-common.v1.schema.json#/$defs/secretSlot" }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["restartRequired"],
        "properties": { "restartRequired": { "const": true } }
      },
      "then": {
        "required": ["activeConfiguration"],
        "properties": {
          "configApplies": { "const": "app-restart" },
          "activeConfiguration": true
        }
      },
      "else": { "properties": { "activeConfiguration": false } }
    }
  ]
}
