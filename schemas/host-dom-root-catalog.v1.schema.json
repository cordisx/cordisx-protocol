{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-dom-root-catalog.v1.schema.json",
  "title": "CordisX Host DOM Root Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "authority", "catalogVersion", "hostGeneration", "roots"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/host-dom-root-catalog.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "authority": { "const": "host" },
    "catalogVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "hostGeneration": { "type": "string", "minLength": 1, "maxLength": 200 },
    "roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rootId", "name", "description", "sensitivity", "availability", "readOperations", "modifyOperations"],
        "properties": {
          "rootId": { "$ref": "host-dom-common.v1.schema.json#/$defs/rootId" },
          "name": { "$ref": "host-dom-common.v1.schema.json#/$defs/boundedLocalizedText" },
          "description": { "$ref": "host-dom-common.v1.schema.json#/$defs/boundedLocalizedText" },
          "sensitivity": { "enum": ["general", "sensitive", "high-risk"] },
          "availability": { "enum": ["available", "unavailable"] },
          "unavailableReason": { "enum": ["unsupported", "not-mounted", "profile-unavailable", "generation-replaced"] },
          "readOperations": {
            "type": "array", "maxItems": 4, "uniqueItems": true,
            "items": { "$ref": "host-dom-common.v1.schema.json#/$defs/readOperation" }
          },
          "modifyOperations": {
            "type": "array", "maxItems": 5, "uniqueItems": true,
            "items": { "$ref": "host-dom-common.v1.schema.json#/$defs/modifyOperation" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "availability": { "const": "available" } }, "required": ["availability"] },
            "then": { "properties": { "unavailableReason": false } },
            "else": { "required": ["unavailableReason"], "properties": { "unavailableReason": true } }
          },
          {
            "if": { "properties": { "modifyOperations": { "type": "array", "minItems": 1 } }, "required": ["modifyOperations"] },
            "then": { "properties": { "sensitivity": { "const": "high-risk" } } },
            "else": {
              "if": { "properties": { "readOperations": { "type": "array", "minItems": 1 } }, "required": ["readOperations"] },
              "then": { "properties": { "sensitivity": { "const": "sensitive" } } },
              "else": { "properties": { "sensitivity": { "const": "general" } } }
            }
          }
        ]
      }
    }
  }
}
