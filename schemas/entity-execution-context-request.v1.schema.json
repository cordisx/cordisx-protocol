{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/entity-execution-context-request.v1.schema.json",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "agentId",
        "revision"
      ],
      "additionalProperties": false
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "identity",
    "operationId"
  ],
  "additionalProperties": false
}
