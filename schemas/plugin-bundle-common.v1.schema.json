{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-bundle-common.v1.schema.json",
  "title": "CordisX Plugin Bundle Common Definitions v1",
  "$defs": {
    "bundleStatus": {
      "enum": [
        "active",
        "disabled",
        "partial",
        "permission-blocked",
        "version-conflict",
        "installing",
        "updating",
        "enabling",
        "disabling",
        "uninstalling",
        "failed",
        "rollback-failed"
      ]
    },
    "memberState": {
      "enum": [
        "active",
        "disabled",
        "not-installed",
        "shared",
        "permission-blocked",
        "version-conflict",
        "failed"
      ]
    },
    "policy": { "enum": ["ask", "allow", "deny"] },
    "permissionId": {
      "type": "string",
      "pattern": "^permission:[a-f0-9]{64}$"
    },
    "claimKind": { "enum": ["bundle", "direct", "runtime-dependency"] },
    "operationKind": {
      "enum": [
        "inspect-source",
        "install",
        "update",
        "enable",
        "disable",
        "uninstall",
        "set-permissions",
        "set-optional-member",
        "adopt-member"
      ]
    },
    "permissionAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissionId", "policy"],
      "properties": {
        "permissionId": { "$ref": "#/$defs/permissionId" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "pluginPermissionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "permissionId", "policy"],
      "properties": {
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "permissionId": { "$ref": "#/$defs/permissionId" },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "pluginPermissionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "permissionId"],
      "properties": {
        "pluginId": { "$ref": "ui-common.v1.schema.json#/$defs/localId" },
        "permissionId": { "$ref": "#/$defs/permissionId" }
      }
    }
  }
}
