{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/startup-catalog-report.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "target",
    "generation",
    "sequence",
    "catalog"
  ],
  "properties": {
    "contract": {
      "const": "cordisx.startup-catalog-report/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "capabilityId"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "plugin",
        "service"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plugin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "catalog": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "pending",
                "failed"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "generation",
            "modelIds",
            "digest"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "generation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "modelIds": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
